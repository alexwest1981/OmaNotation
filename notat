#!/usr/bin/env python3
"""notat - records both audio sides of a meeting/lecture and turns it into a document.

  notat            starts if nothing is recording, otherwise stops + transcribes
  notat start      start recording
  notat stop       stop, transcribe, write the document (the transcription runs in
                   the background; --wait waits for the document instead)
  notat status     --json for the bar
  notat select <node>  turn a device off/on (notat select all = everything on)
  notat models     show the models and which one is selected
  notat model <id>       choose model (must be downloaded)
  notat download <id>    download a model (percent per line)
  notat speakers on|off  tell speakers apart in the document (Speaker 1, 2 ...)
  notat speakers fetch   download the speaker separation (~70 MB)
  notat transcribe <dir>   transcribe an earlier recording again
  notat meeting "Title"    name the meeting: --participants "A,B", --names "1=A" (see below)
  notat voices [<Name> <wav>] known voices: show, turn on/off, save a voice from a file
  notat forget <Name>       delete a voice profile
  notat search <word>       search the meeting documents (rg against the vault)
  notat latest [--open]     the path to the latest document
  notat devices    show which devices are used (and which have been opted out)
"""
