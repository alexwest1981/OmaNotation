    return VAULT_FALLBACK if os.path.isdir(VAULT_FALLBACK) else os.path.join(HOME, "Documents/Notes")


def load_session():
    try:
        with open(SESSION, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def alive(pid):
    """Is the process alive, and is it still our ffmpeg? (the pid is reused otherwise)"""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return b"ffmpeg" in f.read()
    except OSError:
        return False


def session_pids(sess):
    if not sess:
        return []
    pids = [t.get("pid") for t in sess.get("tracks") or []]
    if sess.get("pid"):
        pids.append(sess["pid"])          # older sessions
    return [p for p in pids if p]


def pid_alive(pid):
    """Is the process alive? (no cmdline check — the child is our own script)"""
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def job_write(pid, rawdir, seconds):
    """The job file is the truth about a running transcription. The bar reads it
    instead of keeping the state in QML memory: reloading the plugin clears the
    memory, not the file."""
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(JOB, "w", encoding="utf-8") as f:
            json.dump({"pid": pid, "dir": rawdir, "seconds": seconds,
                       "started": time.time()}, f)
    except OSError:
        pass


def job_clear():
    try:
        os.unlink(JOB)
    except OSError:
        pass


def job_state():
    """The running transcription, or None. A child that died (killed, crashed)
    must not leave a file claiming it is still working."""
    try:
        with open(JOB, encoding="utf-8") as f:
            d = json.load(f)
    except Exception:
        return None
    if not pid_alive(d.get("pid")):
        job_clear()
        return None
    d["elapsed"] = int(time.time() - (d.get("started") or time.time()))
    return d


def running(sess):
    """True as long as at least one of the recordings is alive."""
    return any(alive(p) for p in session_pids(sess))


def log(msg):
    """Small event log: who (the parent) did what - otherwise it cannot be investigated."""
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        ppid = os.getppid()
        try:
            with open(f"/proc/{ppid}/cmdline", "rb") as f:
                parent = f.read().replace(b"\0", b" ").decode(errors="replace").strip()[:120]
        except OSError:
            parent = "?"
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat(timespec='seconds')} {msg} (parent {ppid}: {parent})\n")
    except OSError:
        pass


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "notat", title, body])


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_atomic(path, text):
    """Write to a temp file and rename.

    Temp + os.replace: a crash in the middle of writing must not leave a half
    document (the note becomes empty/truncated) or a half session.json (which
    then looks like "no recording").
    """
    tmp = path + ".del"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


# ------------------------------------------------------------------ start/stop

def cmd_start(_args):
    sess = load_session()
    if running(sess):
        print(json.dumps({"ok": False, "error": "already recording", "since": sess["started"]}))
        return 0
    tracks = device_list()
    stamp = datetime.now().strftime("%Y-%m-%d %H-%M")
    outdir = os.path.join(RAW_ROOT, stamp)
    n = 2
    while os.path.exists(os.path.join(outdir, "session.json")):
        outdir = os.path.join(RAW_ROOT, f"{stamp}-{n}")   # two recordings in the same minute
        n += 1
    os.makedirs(outdir, exist_ok=True)
    started = []
    for i, (kind, node, label, desc) in enumerate(tracks, 1):
        name = f"{kind}{i}"
        fflog = open(os.path.join(outdir, name + ".log"), "w")
        proc = subprocess.Popen([
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning",
            "-f", "pulse", "-i", node,
            "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", os.path.join(outdir, name + ".wav"),
        ], stdout=fflog, stderr=fflog, stdin=subprocess.DEVNULL, start_new_session=True)
        started.append({"file": name + ".wav", "node": node, "label": label,
                        "desc": desc, "pid": proc.pid})
    time.sleep(1.0)
    live = [t for t in started if alive(t["pid"])]
    if not live:
        why = []
        for t in started:
            try:
                with open(os.path.join(outdir, t["file"].replace(".wav", ".log")),
                          encoding="utf-8", errors="replace") as f:
                    tail = f.read()[-200:].strip()
            except OSError:
                tail = "?"
            why.append(f"{t['desc']}: {tail}")
        # ponytail: one dead device must not silence the others - only zero alive is an error
        print(json.dumps({"ok": False, "error": "no device could be recorded: " + " | ".join(why)},
                         ensure_ascii=False))
        return 1
    info = {"started": time.time(), "dir": outdir, "tracks": live, "pid": live[0]["pid"]}
    os.makedirs(STATE, exist_ok=True)
    text = json.dumps(info, ensure_ascii=False)
    for path in (SESSION, os.path.join(outdir, "session.json")):
        write_atomic(path, text)
    names = ", ".join(t["desc"] for t in live)
    notify("Recording", f"{len(live)} devices: {names[:70]}")
    log(f"start {outdir} {len(live)}/{len(started)} devices: {names}")
    print(json.dumps({"ok": True, "dir": outdir,
                      "tracks": [{"desc": t["desc"], "node": t["node"]} for t in live]},
                     ensure_ascii=False))
    return 0


def stop_ffmpeg(sess):
    pids = [p for p in session_pids(sess) if alive(p)]
    for pid in pids:
        os.kill(pid, signal.SIGINT)          # ffmpeg finishes writing the wav header
    for _ in range(100):
        if not any(alive(p) for p in pids):
            return True
        time.sleep(0.1)
    for pid in pids:
        if alive(pid):
            os.kill(pid, signal.SIGTERM)
    return True


def cmd_stop(args):
    sess = load_session()
    if not sess:
        print(json.dumps({"ok": False, "error": "no recording"}))
        return 1
    was_live = running(sess)
    stop_ffmpeg(sess)
    seconds = int((sess.get("stopped") or time.time()) - sess["started"]) if not was_live else int(time.time() - sess["started"])
    try:
        os.unlink(SESSION)
    except OSError:
        pass
    if seconds < 3 and not args.get("force"):
        notify("No recording", "Shorter than 3 seconds - no document was created")
        log(f"stop aborted: only {seconds}s")
        print(json.dumps({"ok": False, "error": "too short", "seconds": seconds}))
        return 1
    if args.get("wait"):
        path = transcribe_dir(sess["dir"], seconds, summary=not args.get("no-summary"))
        log(f"stop after {seconds}s -> {path}")
        print(json.dumps({"ok": bool(path), "note": path, "seconds": seconds}))
        return 0 if path else 1

    # The transcription must not be a child of the bar widget: reloading the
    # plugin (theme change, edited neighbour, "local plugin changed") kills that
    # child mid-job. Measured 2026-09-29: a 29-minute recording never became a
    # document — the job died silently when the widget was rebuilt. Own child,
    # own session, own job file that the bar can read.
    script = os.path.realpath(__file__)
    logfile = open(os.path.join(sess["dir"], "transcription.log"), "a", encoding="utf-8")
    child = subprocess.Popen([sys.executable, script, "transcribe", sess["dir"], str(seconds)],
                             stdin=subprocess.DEVNULL, stdout=logfile, stderr=logfile,
                             start_new_session=True)
    job_write(child.pid, sess["dir"], seconds)
    log(f"stop after {seconds}s -> transcription continues in the background (pid {child.pid})")
    notify("Transcribing", f"{mmss(seconds)} of audio is being processed — the document arrives when it is done")
    print(json.dumps({"ok": True, "transcribing": True, "dir": sess["dir"],
                      "seconds": seconds}, ensure_ascii=False))
    return 0


# ------------------------------------------------------------------ transcription

def whisper(wav, outbase, model, vad):
    # NOT -nt: without timestamps whisper merges the speech into a few blobs (measured:
    # 3 segments of 18-46 s for 110 s of speech, vs 24 segments of 1-5 s with timestamps).
    # Coarse segments make both the document harder to read and the speaker separation impossible.
    args = [WHISPER, "-m", model, "-f", wav, "-l", LANG, "-oj", "-of", outbase, "-t", "12"]
    if vad:
        args += ["--vad", "-vm", vad]
    r = sh(*args)
    path = outbase + ".json"
    if not os.path.exists(path):
        return None, (r.stderr or r.stdout or "whisper gave no output").strip()[-400:]
    with open(path, encoding="utf-8") as f:
        return json.load(f), None


def segments(data, speaker):
    """whisper-cli's JSON -> [(start_sec, end_sec, speaker, text)]"""
    out = []
    for seg in (data or {}).get("transcription", []):
        text = (seg.get("text") or "").strip()
        if not text:
            continue
        off = seg.get("offsets") or {}
        start = (off.get("from") or 0) / 1000.0
        end = (off.get("to") or 0) / 1000.0
        if "[" in text or "(musik" in text.lower():     # whisper noise markers
            continue
        out.append((start, end, speaker, text))
    return out


def paragraphs(segs, gap=3.0, maxlen=400):
    """Merges adjacent lines from the same speaker - a readable document."""
    out = []
    for start, end, who, text in segs:
        if out and out[-1][2] == who and start - out[-1][1] < gap and len(out[-1][3]) < maxlen:
            out[-1][1] = end
            out[-1][3] += " " + text
        else:
            out.append([start, end, who, text])
    return out


def envelope(path, hop_ms=20):
    """RMS per 20 ms - an envelope to compare audio with.

    ponytail: a pure Python loop over the samples (~6 s per hour and track). numpy if it
    becomes a nuisance, but it is not guaranteed to be on the machine.
    """
    import array
    import wave
    try:
        with wave.open(path, "rb") as w:
            if w.getsampwidth() != 2:
                return None, 0.0
            rate = w.getframerate()
            raw = w.readframes(w.getnframes())
    except (wave.Error, OSError, EOFError):
        return None, 0.0
    a = array.array("h")
    a.frombytes(raw[:len(raw) // 2 * 2])
    step = max(1, int(rate * hop_ms / 1000))
    env = [max((abs(v) for v in a[i:i + step]), default=0)
           for i in range(0, len(a) - step + 1, step)]
    return env, hop_ms / 1000.0


def korr(a, b, max_lag=50):
    """The highest normalized correlation between two envelopes, searching over the delay.

    ±max_lag windows cover the fact that the audio takes a different path to a microphone and to
    the output's monitor.
    """
    n = min(len(a), len(b))
    if n < 5:
        return 0.0
    a, b = a[:n], b[:n]
    ma, mb = sum(a) / n, sum(b) / n
    da, db = [x - ma for x in a], [y - mb for y in b]
    best = 0.0
    for lag in range(-max_lag, max_lag + 1):
        x, y = (da[:n - lag], db[lag:]) if lag >= 0 else (da[-lag:], db[:n + lag])
        if len(x) < 5:
            continue
        num = sum(p * q for p, q in zip(x, y))
        den = (sum(p * p for p in x) ** 0.5) * (sum(q * q for q in y) ** 0.5)
        if den > 0:
            best = max(best, num / den)
    return best


def track_no(par):
    try:
        return int(par[2].split("#")[1])
    except (IndexError, ValueError):
        return 0


def dedupe(paras, envs, ratio=0.85, slack=8.0):
    """The same audio captured by several devices must not appear several times.

    The text is no good as a measure: whisper writes different words for the same sentence depending on
    which microphone heard it (measured: "Vi börjar om den här kursen" against "Någonting i
    början av kursen" - 0.4 in text similarity for the same second). The envelopes, however, are the same
    audio. The strongest copy is kept - the line audio sits highest when the meeting is heard in
    the speakers, your own microphone when you are talking.

    Measured twice, because this function has two traps:

    - **The paragraph boundaries slide between devices.** Whisper places the same sentence a few
      seconds differently on different tracks (measured: "ut 46-48 s" against "mic 48-52 s" for the same
      sentence). Comparing only the time both paragraphs *claim* to cover gave 0.57
      and the duplicate slipped through. Therefore the closeness in time (slack) decides whether the pair is the same
      event, and then one device's time window is compared with the other's audio at
      the *same* point in time (0.99 - the duplicate is found).
    - **The union of the two windows is no good as a comparison.** When both tracks carry
      the same audio, any common window gives 0.99, even for two paragraphs 20
      seconds apart - everything would be merged. The window must be the one device's own.
    """
    def level(par):
        env, hop = envs.get(track_no(par), (None, 0))
        if not env:
            return 0.0
        seg = env[int(par[0] / hop):int(par[1] / hop)] or [0]
        return sum(seg) / len(seg)

    def same_audio(p, q):
        if abs(p[0] - q[0]) > slack or p[1] <= p[0]:
            return False
        envp, hopp = envs.get(track_no(p), (None, 0))
        envq, hopq = envs.get(track_no(q), (None, 0))
        if not envp or not envq or hopp != hopq:
            return False
        a = envp[int(p[0] / hopp):int(p[1] / hopp)]
        b = envq[int(p[0] / hopq):int(p[1] / hopq)]     # same time, the other device
        return korr(a, b) >= ratio

    # Strongest first: then it is always the strongest copy that is left, and the list of
    # kept paragraphs only needs to grow (sorted by start time, bisect finds the candidates).
    # Without the time sort every paragraph would have been compared with all of them (an hour-long meeting with
    # speaker separation becomes thousands of paragraphs).
    keep, start = [], []
    for p in sorted(paras, key=lambda x: -level(x)):
        duplicate = False
        for q in keep[bisect.bisect_left(start, p[0] - slack):]:
            if q[0] - p[0] > slack:
                break
            if track_no(p) == track_no(q):               # same device -> never a duplicate
                continue
            if same_audio(p, q):
                duplicate = True
                break
        if not duplicate:
            i = bisect.bisect_left(start, p[0])
            keep.insert(i, p)
            start.insert(i, p[0])
    # The same start time is common when two devices share a paragraph: then the track number decides so
    # the order is the same every time (stable sorting was not enough when the paragraphs are laid
    # down strongest-first).
    keep.sort(key=lambda p: (p[0], track_no(p)))
    return keep


def echo_paragraphs(paras, envs, track_kind, ratio=0.5):
    """Counts microphone paragraphs that heard the output (i.e. the meeting went through the speakers).

    Measured on a real run: microphone against output gave 0.64-0.70 in whole-paragraph
    correlation when the audio was heard in the room, while different audio at the same time lies below
    0.3. The limit 0.5 separates the two cases. Which track is which comes from
    'track_kind' (the diarisation may have swapped the speaker label in the text).
    """
    out = [p for p in paras if track_kind.get(track_no(p)) == "out"]
    mic = [p for p in paras if track_kind.get(track_no(p)) == "in"]
    hits = 0
    for p in mic:
        for q in out:
            shortest = min(p[1] - p[0], q[1] - q[0])
            if shortest <= 0 or min(p[1], q[1]) - max(p[0], q[0]) < 0.5 * shortest:
                continue
            envp, hopp = envs.get(track_no(p), (None, 0))
            envq, hopq = envs.get(track_no(q), (None, 0))
            if not envp or not envq or hopp != hopq:
                continue
            if korr(envp[int(p[0] / hopp):int(p[1] / hopp)],
                    envq[int(q[0] / hopq):int(q[1] / hopq)]) >= ratio:
                hits += 1
                break
    return hits, len(mic)


def speakers_in_text(paras):
    """The speakers that actually appear in the document.

    Diarisation labels each track on its own and creates clusters that later
    disappear with the duplicates, so the label list is bigger than the text.
    The document must not claim more voices than it shows (measured: 24 labels
    for 7 speakers in the text).
    """
    return sorted({p[2].split("#")[0] for p in paras if p[2].split("#")[0] != "Meeting"},
                  key=lambda s: (not s.startswith("You"), s))


def mmss(sec):
    sec = int(sec)
    return f"{sec // 60:02d}:{sec % 60:02d}"


# ------------------------------------------------------------------ summarization

SUMMARY_SYS = ("You summarize transcripts from meetings and lectures. Write the summary in "
               "the language the transcript is in. "
               "Answer in markdown, short and concrete, without an introduction or explanation of what you are doing.")


def ai_config():
    """The AI settings are read from OmaScribe's config, so they follow the user's own choices."""
    cfg = {}
    try:
        with open(OMASCRIBE_CFG, encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        pass
    endpoint = os.environ.get("NOTAT_AI_ENDPOINT") or cfg.get("ai_endpoint") or ""
    key = (os.environ.get("NOTAT_AI_KEY") or cfg.get("ai_key")
           or os.environ.get("OMNIROUTE_API_KEY") or "")
    model = os.environ.get("NOTAT_AI_MODEL") or cfg.get("ai_model") or "OmniRoute"
    return endpoint, key, model


def ai_chat(endpoint, key, model, system, user, timeout=180):
    body = json.dumps({"model": model, "messages": [
        {"role": "system", "content": system},
        {"role": "user", "content": user}]}).encode()
    req = urllib.request.Request(
        endpoint.rstrip("/") + "/chat/completions", data=body,
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + key})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())["choices"][0]["message"]["content"].strip()


def chunks(text, size=16000):
    """Splits on paragraph boundaries: an hour-long lecture does not fit in one call."""
    out, cur = [], ""
    for para in text.split("\n\n"):
        if cur and len(cur) + len(para) > size:
            out.append(cur)
            cur = ""
        cur += para + "\n\n"
    if cur.strip():
        out.append(cur)
    return out


def summarize(transcript):
    """(summary, error). An error must never stop the document."""
    endpoint, key, model = ai_config()
    if not endpoint:
        return None, "no AI endpoint configured"
    try:
        parts = chunks(transcript)
        if len(parts) == 1:
            txt = ai_chat(endpoint, key, model, SUMMARY_SYS,
                          "Summarize: a short overview in 3-5 bullets, then 'Decisions', "
                          "'Tasks' and 'Key terms' if such are mentioned.\n\n" + parts[0])
        else:
            partial = [ai_chat(endpoint, key, model, SUMMARY_SYS,
                               f"This is part {i} of {len(parts)} of a transcript. Summarize the section "
                               "in bullets (include decisions, tasks, dates, names).\n\n" + p)
                       for i, p in enumerate(parts, 1)]
            txt = ai_chat(endpoint, key, model, SUMMARY_SYS,
                          "Merge these partial summaries into ONE: a short overview in 3-5 bullets, "
                          "then 'Decisions', 'Tasks' and 'Key terms'.\n\n" + "\n\n".join(partial))
        return txt, None
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"


def transcribe_dir(rawdir, seconds, summary=True):
    if not os.path.isdir(rawdir):
        sys.exit(f"notat: {rawdir} does not exist")
    meta = {}
    try:
        with open(os.path.join(rawdir, "session.json"), encoding="utf-8") as f:
            meta = json.load(f)
    except Exception:
        pass
    tracks = [(t["file"], t.get("label", "Meeting"), t.get("desc") or t["file"])
              for t in (meta.get("tracks") or []) if t.get("file")]
    if not tracks:      # older recording, or a dir where the session is gone
        tracks = [("remote.wav", "Meeting", "the audio output"), ("mic.wav", "You", "the microphone")]

    def duration(path):
        r = sh("ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path)
        try:
            return float(r.stdout.strip())
        except ValueError:
            return 0.0

    if not seconds:      # re-transcription: the length is in the file, not in any session
        seconds = int(meta.get("seconds") or 0)
    if not seconds:
        for f, _l, _d in tracks:
            p = os.path.join(rawdir, f)
            if os.path.exists(p):
                seconds = int(duration(p))
                break

    model = find_model()
    vad = find_vad()
    speakers = speakers_enabled()
    speaker_count = int(notat_config().get("speaker_count") or 0)
    names = meta.get("names") or {}
    all_segs = []
    failures = []
    sources = []
    envs = {}
    diar_map = {}          # track number -> speaker turns
    labels = {}            # track number -> {speaker_00: 'Speaker 1', ...}
    recognized = set()     # names that came from the voice registry, not from the user - marked in the document
    track_kind = {}        # track number -> 'out' (the meeting) or 'in' (microphone)
    speaker_counter = 0
    for i, (f, who, desc) in enumerate(tracks, 1):
        p = os.path.join(rawdir, f)
        if not os.path.exists(p):
            failures.append(f"{desc}: no file (the device died during recording)")
            continue
        track_kind[i] = "out" if who.startswith("Meeting") else "in"
        dur = duration(p)
        if dur >= 1:
            sources.append(f"{desc} ({mmss(dur)})")
        envs[i] = envelope(p)
        if speakers and dur >= 15:
            turns, diar_err = diar_turns(p, speaker_count)
            if turns:
                raw_labels = diar_labels(turns, dominant="You" if who.startswith("You") else None,
                                         base=speaker_counter)
                diar_map[i] = turns
                # the numbering is counted on the raw labels: a name must not shift the next track's number
                speaker_counter += sum(1 for v in raw_labels.values() if v.startswith("Speaker"))
                labels[i] = rename_speakers(raw_labels, names)
                if names:
                    apply_names(p, diar_map[i], labels[i], names, envs.get(i))
                if names_enabled():
                    # known voice -> the name, otherwise Speaker N stays (no guess)
                    known = known_voices(p, diar_map[i], labels[i], envs.get(i))
                    if known:
                        recognized |= set(known.values())
                        labels[i] = rename_speakers(labels[i], known)
            else:
                failures.append(f"{desc}: the speaker separation failed ({diar_err})")
                log(f"diarisation of {f}: {diar_err}")
        data, err = whisper(p, os.path.join(rawdir, os.path.splitext(f)[0]), model, vad)
        if err:
            failures.append(f"{desc}: {err}")
            continue
        # the device's number in the speaker label: two microphones share the same "You" but are different tracks
        segs = segments(data, f"{who}#{i}")
        if labels.get(i):
            # the speaker is set per segment: only after that are paragraphs merged, otherwise a
            # paragraph can span several voices and the label becomes a guess
            segs = label_segments(segs, diar_map[i], labels[i])
        all_segs += segs
    all_segs.sort(key=lambda s: s[0])
    paras = dedupe(paragraphs(all_segs), envs)

    stamp = os.path.basename(rawdir)
    try:   # the first 16 characters are the timestamp even when the folder got a "-2" tail
        when = datetime.strptime(stamp[:16], "%Y-%m-%d %H-%M").strftime("%Y-%m-%d %H:%M")
    except ValueError:
        when = stamp
    title = (meta.get("title") or "").strip() or f"Meeting {stamp}"
    title = title.replace("/", "-")        # the heading also becomes a file name
    lines = [f"# {title}", "",
             f"**Recorded:** {when} · {mmss(seconds)} · "
             f"{'VAD' if vad else 'no VAD'} · {'speakers · ' if labels else ''}"
             f"model {model_name(model)}", ""]
    if meta.get("participants"):
        lines += [f"**Participants:** {' · '.join(meta['participants'])}", ""]
    if sources:
        lines += [f"**Sources:** {' · '.join(sources)}", ""]
    if labels:
        used = speakers_in_text(paras)
        if used:
            shown = " · ".join(f"{n} (voice)" if n in recognized else n for n in used)
            lines += [f"**Speakers:** {shown} — the voices are told apart locally, "
                      "the numbers apply to this recording", ""]
    lines += [f"**Raw audio:** `{rawdir}`", ""]
    if not vad:
        lines += ["> [!warning] No VAD model found - silent parts can become invented text", ""]
    echo, mic_count = echo_paragraphs(paras, envs, track_kind)
    if echo:
        lines += [f"> [!warning] The meeting audio was heard in the room ({echo} of {mic_count} microphone pieces "
                  "is the same audio as the output): the same discussion therefore appears twice. "
                  "Headphones - or echo cancellation in the meeting app - give a clean text.", ""]
    if failures:
        lines += ["> [!warning] The transcription is incomplete", *[f"> {f}" for f in failures], ""]
    if not paras:
        lines += ["_No speech was found in the recording._", ""]
    lines += ["## Transcript", ""]
    for start, _end, who, text in paras:
        lines.append(f"**[{mmss(start)}] {who.split('#')[0]}:** {text}")
        lines.append("")
    lines += ["## My notes", "", ""]
    content = "\n".join(lines)

    dest = docs_dir()
    os.makedirs(dest, exist_ok=True)
    path = os.path.join(dest, f"{title}.md")
    n = 2
    while os.path.exists(path):
        path = os.path.join(dest, f"{title} {n}.md")
        n += 1
    write_atomic(path, content)

    notify("Note ready", f"{os.path.basename(path)} · {len(paras)} paragraphs")

    # The summary is fetched AFTER the document has been written: a slow or dead
    # AI service must never cost you the transcript.
    if summary and paras:
        transcript = "\n".join(f"[{mmss(s)}] {who.split('#')[0]}: {text}" for s, _e, who, text in paras)
        log(f"summarizing {len(transcript)} characters via AI ...")
        txt, err = summarize(transcript)
        if txt:
            try:
                with open(path, encoding="utf-8") as f:
                    current = f.read()
                marker = "## Transcript"
                if marker in current:
                    head, rest = current.split(marker, 1)
                    write_atomic(path, head + "## Summary\n\n" + txt + "\n\n" + marker + rest)
                log(f"summary inserted ({len(txt)} characters)")
            except OSError as e:
                log(f"could not insert the summary: {e}")
        else:
            log(f"no summary: {err}")
            notify("No summary", err or "unknown error")
    return path


def model_name(path):
    """The model's name for the document - the file name 'ggml-model.bin' says nothing."""
    for m in MODELS:
        if model_path(m["id"]) == path:
            return m["id"]
    return os.path.basename(path)


def cmd_transcribe(args):
    rawdir = args["_"][0] if args["_"] else None
    if not rawdir:
        sys.exit("notat transcribe <dir with remote.wav/mic.wav> [seconds]")
    meta = {}
    try:
        with open(os.path.join(rawdir, "session.json"), encoding="utf-8") as f:
            meta = json.load(f)
    except Exception:
        pass
    seconds = int(args["_"][1]) if len(args["_"]) > 1 else int(meta.get("seconds") or 0)
    job_write(os.getpid(), rawdir, seconds)
    try:
        path = transcribe_dir(rawdir, seconds, summary=not args.get("no-summary"))
        log(f"transcription done ({seconds}s) -> {path}")
        print(path)
    finally:
        job_clear()
    return 0


