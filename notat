def latest_raw():
    """The latest recording folder - 'notat meeting' with no ongoing recording applies to it."""
    try:
        folders = sorted(d for d in os.listdir(RAW_ROOT)
                         if os.path.isdir(os.path.join(RAW_ROOT, d)))
    except OSError:
        return None
    return os.path.join(RAW_ROOT, folders[-1]) if folders else None


def docs_dir():
    """Where the documents are - the same path transcribe_dir writes to.

    Recordings/ is the folder, but an install that already has the old Inspelningar/ keeps
    using it: the documents are the user's, and they are not moved behind their back.
    """
    root = vault_root()
    if os.path.isdir(os.path.join(root, VAULT_FOLDER)) or not os.path.isdir(os.path.join(root, VAULT_FOLDER_OLD)):
        return os.path.join(root, VAULT_FOLDER)
    return os.path.join(root, VAULT_FOLDER_OLD)


def latest_doc():
    """The most recently written meeting document (mtime, not name - 'Meeting <stamp>' is local)."""
    try:
        files = [os.path.join(docs_dir(), f) for f in os.listdir(docs_dir())
                 if f.endswith(".md")]
    except OSError:
        return None
    return max(files, key=os.path.getmtime) if files else None


def name_pairs(text):
    """'1=Ada, Speaker 2=Bo' -> {'Speaker 1': 'Ada', 'Speaker 2': 'Bo'}"""
    out = {}
    for pair in (text or "").split(","):
        key, eq, value = pair.partition("=")
        key, value = key.strip(), value.strip()
        if eq and value:
            out[key if not key.isdigit() else f"Speaker {key}"] = value
    return out


def cmd_meeting(args):
    """Title and participants for a recording - written in its session.json.

    It is the same file the transcription reads, so the names end up in the document without
    extra steps. Without an ongoing recording the latest folder applies (the answer says which).
    """
    sess = load_session()
    folder = args.get("dir") or (sess.get("dir") if running(sess) else None) or latest_raw()
    if not folder:
        print(json.dumps({"ok": False, "error": "no recording found"}, ensure_ascii=False))
        return 1
    meta_path = os.path.join(folder, "session.json")
    meta = read_json(meta_path)
    if meta is None:
        print(json.dumps({"ok": False, "error": f"{folder} has no readable session.json"},
                         ensure_ascii=False))
        return 1
    title = args["_"][0] if args["_"] else args.get("title")
    missing = [k for k in ("title", "participants", "names", "dir") if args.get(k) is True]
    if missing:      # --participants without a value must say so, not be ignored
        print(json.dumps({"ok": False, "error": "value missing for " +
                          ", ".join("--" + k for k in missing)}, ensure_ascii=False))
        return 1
    if isinstance(title, str) and title.strip():
        meta["title"] = title.strip()
    if isinstance(args.get("participants"), str):
        meta["participants"] = [n.strip() for n in args["participants"].split(",") if n.strip()]
    if isinstance(args.get("names"), str):
        meta["names"] = {**(meta.get("names") or {}), **name_pairs(args["names"])}
    if args.get("clear"):
        for key in ("title", "participants", "names"):
            meta.pop(key, None)
    try:
        write_atomic(meta_path, json.dumps(meta, ensure_ascii=False))
    except OSError as e:
        print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
        return 1
    log(f"meeting {folder}: title={meta.get('title')!r} participants={meta.get('participants')} "
        f"names={meta.get('names')}")
    print(json.dumps({"ok": True, "dir": folder, "title": meta.get("title"),
                      "participants": meta.get("participants") or [],
                      "names": meta.get("names") or {}}, ensure_ascii=False))
    return 0


def voice_catalog():
    """The registry as JSON - the bar and `notat voices` read the same thing."""
    return {"enabled": names_enabled(), "root": VOICE_ROOT, "threshold": VOICE_THRESHOLD,
            "voices": [{"name": n, "seconds": round(os.path.getsize(p) / 2 / 16000, 1)}
                       for n, p in references()]}


def cmd_voices(args):
    """Known voices: show the registry, turn name recognition on/off, or save a voice.

      notat voices                    show the registry
      notat voices on|off             turn automatic renaming on/off
      notat voices Ada ~/voices/ada.wav   save a voice from a file (16 kHz mono)
    """
    first = args["_"][0] if args["_"] else ""
    if first.lower() in ("on", "off", "true", "false"):
        enabled = first.lower() in ("on", "true")
        cfg = notat_config()
        cfg["names"] = enabled
        try:
            os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
            write_atomic(CONFIG, json.dumps(cfg, ensure_ascii=False, indent=2))
        except OSError as e:
            print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
            return 1
        log(f"name recognition {first}")
        print(json.dumps({**voice_catalog(), "ok": True}, ensure_ascii=False))
        return 0
    if not first:
        print(json.dumps(voice_catalog(), ensure_ascii=False, indent=2))
        return 0
    if len(args["_"]) < 2:
        print(json.dumps({"ok": False, "error": "usage: notat voices <Name> <wav-file>"},
                         ensure_ascii=False))
        return 1
    name, file = first, args["_"][1]
    if not os.path.exists(file):
        print(json.dumps({"ok": False, "error": f"{file} does not exist"}, ensure_ascii=False))
        return 1
    if not save_voice(name, file):
        print(json.dumps({"ok": False, "name": name,
                          "error": f"could not save the voice: {file} must be 16 kHz mono wav "
                                   f"with at least {int(VOICE_MIN)} s of speech, and a longer reference already exists"},
                         ensure_ascii=False))
        return 1
    log(f"voice saved for {name} from {file}")
    print(json.dumps({**voice_catalog(), "ok": True, "name": name}, ensure_ascii=False))
    return 0


def cmd_forget(args):
    """notat forget <Name> - delete the voice profile (voices are biometrics)."""
    name = args["_"][0] if args["_"] else ""
    path = os.path.join(VOICE_ROOT, name.replace("/", "-") + ".wav") if name else ""
    if not name or not os.path.exists(path):
        print(json.dumps({"ok": False, "error": f"no voice profile for {name or '?'}"},
                         ensure_ascii=False))
        return 1
    os.unlink(path)
    log(f"voice profile removed: {name}")
    print(json.dumps({**voice_catalog(), "ok": True, "removed": name}, ensure_ascii=False))
    return 0


def cmd_search(args):
    """notat search <word> - searches the vault's meeting documents.

    Measured on this machine (100-1000 documents): a recursive search takes under 0.01 s,
    an FTS5 index is built in 0.3 s and queried in 1 ms — for occasional searches the
    index is just extra to keep in sync. ripgrep first, then.
    """
    word = args["_"][0] if args["_"] else ""
    if not word:
        print(json.dumps({"ok": False, "error": "usage: notat search <word>"}, ensure_ascii=False))
        return 1
    if not shutil.which("rg"):
        print(json.dumps({"ok": False, "error": "ripgrep (rg) is missing"}, ensure_ascii=False))
        return 1
    r = sh("rg", "-n", "--no-heading", "--color=never", "-F", word, docs_dir())
    lines = (r.stdout or "").splitlines()
    if not lines:
        print(f"no hits for {word!r} in {docs_dir()}")
        return 1
    for line in lines:
        print(line)
    print(f"\n{len(lines)} hits in {docs_dir()}")
    return 0


def cmd_latest(args):
    """notat latest [--open] - the path to the most recently written document."""
    path = latest_doc()
    if not path:
        print(json.dumps({"ok": False, "error": f"no documents in {docs_dir()}"}, ensure_ascii=False))
        return 1
    if args.get("open") and shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", path])
    print(path)
    return 0


def cmd_toggle(_args):
    sess = load_session()
    return cmd_stop({}) if running(sess) else cmd_start({})


USAGE = __doc__


def main(argv):
    if not argv:
        return cmd_toggle({})
    cmd, rest = argv[0], argv[1:]
    # --key=value and --key value; only those that take a value may swallow the next word,
    # so --wait/--json/--clear stay plain switches.
    value_flags = ("title", "participants", "names", "dir")
    flags = {"_": []}
    i = 0
    while i < len(rest):
        a = rest[i]
        if a.startswith("--"):
            key, eq, value = a[2:].partition("=")
            nxt = rest[i + 1] if i + 1 < len(rest) else None
            if not eq and key in value_flags and nxt is not None and not nxt.startswith("--"):
                eq, value = "=", nxt
                i += 1
            flags[key] = value if eq else True
        else:
            flags["_"].append(a)
        i += 1
    table = {"start": cmd_start, "stop": cmd_stop, "status": cmd_status,
             "transcribe": cmd_transcribe, "devices": cmd_devices, "toggle": cmd_toggle,
             "select": cmd_select, "models": cmd_models, "model": cmd_model,
             "download": cmd_download, "speakers": cmd_speakers,
             "meeting": cmd_meeting, "voices": cmd_voices, "forget": cmd_forget,
             "search": cmd_search, "latest": cmd_latest}
    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if cmd not in table:
        sys.exit(USAGE)
    return table[cmd](flags)


