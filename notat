# ------------------------------------------------------------------ helpers

def sh(*args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def model_path(mid):
    """Where is the model? Downloaded ones are in MODEL_ROOT/<id>/, the system's in MODEL_DIRS."""
    m = next((x for x in MODELS if x["id"] == mid), None)
    if not m:
        return None
    p = os.path.join(MODEL_ROOT, mid, m["file"])
    if os.path.exists(p):
        return p
    for d in MODEL_DIRS:
        if d and os.path.exists(os.path.join(d, m["file"])):
            return os.path.join(d, m["file"])
    return None


def model_catalog():
    selected = notat_config().get("model") or ""
    return [{**m, "downloaded": bool(model_path(m["id"])), "selected": m["id"] == selected,
             "path": model_path(m["id"])} for m in MODELS]


def find_model():
    """The selected model from config (the bar's menu), otherwise NOTAT_MODEL, otherwise the default order."""
    for key, value in (("config", notat_config().get("model")),
                       ("NOTAT_MODEL", os.environ.get("NOTAT_MODEL"))):
        if not value:
            continue
        if os.path.exists(value):
            return value
        p = model_path(value)
        if p:
            return p
        sys.exit(f"notat: model '{value}' ({key}) is not downloaded - "
                 f"open the source menu in the bar or run: notat download {value}")
    for d in MODEL_DIRS:
        if not d:
            continue
        for name in FOLDERS:
            p = os.path.join(d, f"ggml-{name}.bin")
            if os.path.exists(p):
                return p
    sys.exit("notat: no whisper model found (set NOTAT_MODEL or download one in the bar)")


def download_file(url, tmp, min_mb=1):
    """Streams a file to tmp and writes {"percent": N} per line (the bar's meter reads them)."""
    req = urllib.request.Request(url, headers={"User-Agent": "notat/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got, nxt = 0, 0
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)
            got += len(chunk)
            p = int(got * 100 / total) if total else 0
            if p >= nxt:
                print(json.dumps({"percent": p, "mb": got >> 20}), flush=True)
                nxt = p + 5
    if os.path.getsize(tmp) < min_mb * 1_000_000:
        raise ValueError("the file is too small - the download went wrong")


def speakers_enabled():
    cfg = notat_config()
