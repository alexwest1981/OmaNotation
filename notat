def diar_available():
    return all(os.path.exists(f["ready"]) for f in DIAR_FILES)


def cmd_diar_download(_args):
    """Fetches sherpa-onnx + segmentation + embedding (~70 MB) for the speaker separation."""
    import tarfile
    os.makedirs(DIAR_ROOT, exist_ok=True)
    try:
        for f in DIAR_FILES:
            if os.path.exists(f["ready"]):
                print(json.dumps({"ok": True, "already": True, "what": f["name"]}, ensure_ascii=False))
                continue
            if f["tar"]:
                tmp = os.path.join(DIAR_ROOT, os.path.basename(f["url"]))
                download_file(f["url"], tmp, min_mb=5)
                out = tmp + ".out"
                os.makedirs(out, exist_ok=True)
                with tarfile.open(tmp, "r:bz2") as t:
                    try:
                        t.extractall(out, filter="data")
                    except TypeError:                 # python < 3.12
                        t.extractall(out)
                inner = os.path.join(out, os.listdir(out)[0])   # the package has a top directory
                shutil.copytree(inner, f["dest"], dirs_exist_ok=True)
                shutil.rmtree(out, ignore_errors=True)
                os.unlink(tmp)
                if os.path.exists(DIAR_BIN):
                    os.chmod(DIAR_BIN, 0o755)
            else:
                os.makedirs(os.path.dirname(f["dest"]), exist_ok=True)
                download_file(f["url"], f["dest"] + ".del", min_mb=5)
                os.replace(f["dest"] + ".del", f["dest"])
            print(json.dumps({"ok": True, "what": f["name"], "done": diar_available()}, ensure_ascii=False))
    except Exception as e:
        log(f"speakers fetch failed: {e}")
        print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}, ensure_ascii=False))
        return 1
    log("speakers fetch done")
    print(json.dumps({"ok": True, "path": DIAR_ROOT, "speakers": True}, ensure_ascii=False))
    return 0


def cmd_speakers(args):
    """notat speakers on|off|fetch - tell speakers apart in the document as Speaker 1, 2 ..."""
    val = (args["_"][0] if args["_"] else "").lower()
    if val == "fetch":
        return cmd_diar_download(args)
    if val not in ("on", "off", "true", "false"):
        print(json.dumps({"ok": False, "error": "usage: notat speakers on|off"}, ensure_ascii=False))
        return 1
    enabled = val in ("on", "true")
    if enabled and not diar_available():
        print(json.dumps({"ok": False, "missing": True,
                          "error": "the speaker separation is not downloaded (run: notat speakers fetch)"},
                         ensure_ascii=False))
        return 1
    cfg = notat_config()
    cfg["speakers"] = enabled
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except OSError as e:
        print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
        return 1
    log(f"speakers {val}")
    print(json.dumps({"ok": True, "speakers_enabled": enabled, "speaker_count": cfg.get("speaker_count") or 0},
                     ensure_ascii=False))
    return 0


def diar_turns(wav, speaker_count=0, threshold=None):
    """Speaker turns from a wav: ([(start, end, 'speaker_00')], error)."""
    if not diar_available():
        return None, "the speaker separation is not downloaded (run: notat speakers fetch)"
    args = [DIAR_BIN, "--segmentation.pyannote-model=" + DIAR_SEG, "--embedding.model=" + DIAR_EMB]
    if speaker_count:
        args.append(f"--clustering.num-clusters={speaker_count}")
    else:
        args.append(f"--clustering.cluster-threshold={threshold or DIAR_THRESHOLD}")
    env = dict(os.environ)
    lib = os.path.join(DIAR_ROOT, "sherpa/lib")
    if os.path.isdir(lib):
        env["LD_LIBRARY_PATH"] = lib + ":" + env.get("LD_LIBRARY_PATH", "")
    r = sh(*args, wav, env=env)
    out = []
    for line in (r.stdout or "").splitlines():
        m = re.match(r"\s*([\d.]+)\s*--\s*([\d.]+)\s+(speaker_\d+)", line)
        if m:
            out.append((float(m.group(1)), float(m.group(2)), m.group(3)))
    if not out:
        return None, (r.stderr or r.stdout or "the diarisation gave no turns").strip()[-300:]
    return out, None


def diar_labels(turns, dominant=None, base=0):
    """The diarisation's speakers -> readable labels, sorted by talk time.

    Whoever talks the most first (the teacher/meeting chair becomes 'Speaker 1'), and on
    the microphone's track the most talkative one gets the label 'You'. 'base' shifts the numbering so
    that speakers from different tracks do not collide.
    """
    talk = {}
    for t in turns:
        talk[t[2]] = talk.get(t[2], 0.0) + (t[1] - t[0])
    out, n = {}, 1
    for i, speaker in enumerate(sorted(talk, key=lambda s: -talk[s])):
        if i == 0 and dominant:
            out[speaker] = dominant
        else:
            out[speaker] = f"Speaker {base + n}"
            n += 1
    return out


def rename_speakers(labels, names):
    """'Speaker 1' -> the name the user gave ('1=Ada' and 'Speaker 1=Ada' both work).

    Only the display label changes. The track number in who#nr is what the duplicate
    and echo logic hangs on, and 'You'/'Meeting' are never renamed.
    """
    if not names:
        return labels
    return {spk: names.get(lbl) or names.get(lbl.split(" ")[-1]) or lbl
            for spk, lbl in labels.items()}


def speaker_at(turns, labels, start, end):
    """The label of the diarisation segment that covers the most of the paragraph (otherwise None)."""
    best, cover = None, 0.0
    for t in turns:
        ov = min(end, t[1]) - max(start, t[0])
        if ov > cover:
            best, cover = t[2], ov
    if best is None or cover < 0.3 * max(0.1, end - start):
        return None
    return labels.get(best)


def label_segments(segs, turns, labels):
    """Puts a speaker label on each whisper segment and keeps the track number in the label.

    Must happen BEFORE paragraphs(): if the paragraphs are merged first, one paragraph can span
    several speakers, and the assignment then becomes a guess instead of a measurement.
    """
    out = []
    for start, end, who, text in segs:
        speaker = speaker_at(turns, labels, start, end)
        nr = who.split("#")[1] if "#" in who else ""
        out.append((start, end, f"{speaker or who.split('#')[0]}#{nr}", text))
    return out


# ------------------------------------------------------------------ the voice registry
#
# Can we recognize a voice between meetings? Yes, with the sherpa binary that already lies in
# diar/ - no new model, nothing new to install. Measured on the diar sample (16 turns, two
# voices): put the reference voice and an unknown turn in the same file with one second of silence
# between them, run the diarisation, and see if the turn lands in the same cluster as the reference.
# The same voice gave 1 cluster, different voices 2 (measured 4/4 isolated, see README). A threshold sweep
# against 14 unknown turns: 14/14 for 0.6-0.8, 13/14 at sherpa's 0.5, and at 0.9 the
# reference voices start to merge.
#
# ponytail: the answer is yes/no/no-idea, not a similarity figure - the threshold
# (NOTAT_VOICE_THRESHOLD, default 0.7) is the knob. If you want figures instead you can
# compute the embedding yourself with onnxruntime (measured 14/14, same voice +0.87 against different
# +0.33), but that requires a package that is not in the repo. Tested on two synthetic
# voices in one room; more voices, worse microphones and crosstalk are not measured.

def wav_read(path, start=0.0, end=None):
    """(rate, bytes) for an interval from a 16-bit mono wav, otherwise (None, None)."""
    import wave
    try:
        with wave.open(path, "rb") as w:
            if w.getsampwidth() != 2 or w.getnchannels() != 1:
                return None, None
            rate = w.getframerate()
            w.setpos(max(0, int(start * rate)))
            n = int((end - start) * rate) if end else w.getnframes() - w.tell()
            return rate, w.readframes(max(0, n))
    except (wave.Error, OSError, EOFError):
        return None, None


def wav_write(path, rate, pieces, silence=1.0):
    """Writes the pieces as ONE wav with silence between them (the diarisation needs the boundary).

    Temp + rename, like the document: a half-written reference must not be readable
    and become a mismatch.
    """
    import wave
    silent = b"\x00\x00" * int(rate * silence)
    with wave.open(path + ".del", "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        for i, chunk in enumerate(pieces):
            if i:
                w.writeframes(silent)
            w.writeframes(chunk)
    os.replace(path + ".del", path)


def best_clip(wav, env=None, hop=0.02, start=None, end=None):
    """(start, end) for the loudest VOICE_CLIP seconds in the interval.

    Uses the envelope the transcription computes anyway, so it does not become silence
    or a cough that becomes someone's voice profile. Without an envelope: take the start of the file.
    """
    start = start or 0.0
    if not env:
        rate, data = wav_read(wav)
        length = len(data) / 2 / rate if rate else 0.0
        return start, min(end or length, start + VOICE_CLIP)
    i = int(start / hop)
    stop = end or len(env) * hop
    j = min(len(env), int(stop / hop))
    if j - i < 3:
        return start, stop
    # the window should be able to slide: at most half the distance, at least VOICE_MIN seconds
    length = min(VOICE_CLIP, max(VOICE_MIN, (stop - start) / 2))
    window = max(1, int(length / hop))
    best, value = i, -1.0
    for k in range(i, max(i + 1, j - window + 1)):
        m = sum(env[k:k + window]) / window
        if m > value:
            best, value = k, m
    return best * hop, min(best * hop + length, stop)


def names_enabled():
    """Automatic name recognition: 'names' in config, otherwise on when the registry is not empty."""
    cfg = notat_config()
    if "names" in cfg:
        return bool(cfg["names"])
    return bool(references())


def references():
    """[(name, wav)] for known voices."""
    try:
        files = sorted(f for f in os.listdir(VOICE_ROOT) if f.endswith(".wav"))
    except OSError:
        return []
    return [(os.path.splitext(f)[0], os.path.join(VOICE_ROOT, f)) for f in files]


def label_for(seg, a, b):
    """The speaker label with the largest overlap with [a, b]."""
    hits = [(min(b, y) - max(a, x), c) for x, y, c in seg if min(b, y) > max(a, x)]
    return max(hits)[1] if hits else None


def voice_match(seg, windows):
    """Index of the reference the last piece belongs with. None if none - or several.

    Pure logic without audio: windows are the time windows in the joined file, the last piece is
    the unknown voice. If it belongs with exactly one reference it is an answer, otherwise no
    guess. Tested in test_notat.py.
    """
    clip = label_for(seg, *windows[-1])
    if not clip:
        return None
    hits = [i for i, win in enumerate(windows[:-1]) if label_for(seg, *win) == clip]
    return hits[0] if len(hits) == 1 else None


def known_voice(clip_wav, refs):
    """Which of the known voices is this? None if none - or several - match."""
    valid, pieces, times = [], [], []
    for name, path in refs:
        rate, data = wav_read(path, 0, VOICE_CLIP)
        if not rate or not data:
            continue
        valid.append(name)
        pieces.append(data)
        times.append((rate, len(data) / 2 / rate))
    rate, data = wav_read(clip_wav)
    if not rate or not data or not valid:
        return None
    pieces.append(data)
    times.append((rate, len(data) / 2 / rate))
    tmp = clip_wav + ".compare.wav"
    wav_write(tmp, rate, pieces, silence=1.0)
    try:
        seg = diar_turns(tmp, 0, VOICE_THRESHOLD)[0]
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    if not seg:
        return None
    start, windows = 0.0, []
    for _rate, length in times:
        windows.append((start, start + length))
        start += length + 1.0
    i = voice_match(seg, windows)
    return valid[i] if i is not None else None


def known_voices(wav, turns, labels, env=None):
    """Names of the clusters whose voice is in the registry - those that have not already been given a name."""
    refs = references()
    if not refs:
        return {}
    out = {}
    for spk, label in labels.items():
        if not label.startswith("Speaker"):       # You/Meeting and manually named ones are not touched
            continue
        own = [t for t in turns if t[2] == spk]
        if not own:
            continue
        start, end, _ = max(own, key=lambda t: t[1] - t[0])
        if end - start < VOICE_MIN:
            continue
        a, b = best_clip(wav, env, start=start, end=end)
        clip = wav_read(wav, a, b)
        if not clip[0]:
            continue
        tmp = os.path.join(os.path.dirname(wav), f".voice_{spk}.wav")
        wav_write(tmp, clip[0], [clip[1]], silence=0)
        try:
            name = known_voice(tmp, refs)
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        if name:
            out[label] = name
            log(f"voice: {label} on {os.path.basename(wav)} recognized as {name}")
    return out


def save_voice(name, wav, env=None, start=None, end=None):
    """Saves a voice as a reference (0600). Already saved and longer -> keep the old one."""
    a, b = best_clip(wav, env, start=start, end=end)
    rate, data = wav_read(wav, a, b)
    if not rate or len(data) < VOICE_MIN * rate * 2:
        return False
    os.makedirs(VOICE_ROOT, mode=0o700, exist_ok=True)
    path = os.path.join(VOICE_ROOT, name.replace("/", "-") + ".wav")
    old = os.path.getsize(path) if os.path.exists(path) else 0
    if old >= len(data):
        return False
    wav_write(path, rate, [data], silence=0)
    os.chmod(path, 0o600)
    return True


def apply_names(wav, turns, labels, names, env=None):
    """A named speaker -> save the voice, so the next meeting gets the name by itself."""
    if not names:
        return
    for spk, label in labels.items():
        if label not in set(names.values()):
            continue
        own = [t for t in turns if t[2] == spk]
        if not own:
            continue
        start, end, _ = max(own, key=lambda t: t[1] - t[0])
        if end - start >= VOICE_MIN and save_voice(label, wav, env, start, end):
            log(f"voice saved: {label} from {os.path.basename(wav)}")


