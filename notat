def cmd_status(args):
    sess = load_session()
    live = running(sess)
    job = job_state()
    info = {"recording": live, "seconds": 0, "dir": None, "started": None,
            "transcribing": job is not None, "transcribing_seconds": 0,
            "transcribing_dir": None}
    if job:
        info["transcribing_seconds"] = job["elapsed"]
        info["transcribing_dir"] = job["dir"]
    if sess:
        info["dir"] = sess.get("dir")
        info["started"] = datetime.fromtimestamp(sess["started"]).strftime("%H:%M")
        if live:
            info["seconds"] = int(time.time() - sess["started"])
    if args.get("json"):
        print(json.dumps(info))
    else:
        print(f"{'RECORDING ' + mmss(info['seconds']) if live else 'not recording'}"
              + (f"  ({info['dir']})" if live else "")
              + (f"  TRANSCRIBING {mmss(info['transcribing_seconds'])}" if job else ""))
    return 0


def cmd_devices(_args):
