def diar_turer(wav, antal_talare=0):
    """Talarturer ur en wav: ([(start, slut, 'speaker_00')], fel)."""
    if not diar_finns():
        return None, "talaruppdelningen är inte nedladdad (kör: notat diar-hamta)"
    args = [DIAR_BIN, "--segmentation.pyannote-model=" + DIAR_SEG, "--embedding.model=" + DIAR_EMB]
    if antal_talare:
        args.append(f"--clustering.num-clusters={antal_talare}")
    else:
        args.append(f"--clustering.cluster-threshold={DIAR_TRÖSKEL}")
    miljö = dict(os.environ)
    lib = os.path.join(DIAR_ROOT, "sherpa/lib")
    if os.path.isdir(lib):
        miljö["LD_LIBRARY_PATH"] = lib + ":" + miljö.get("LD_LIBRARY_PATH", "")
    r = sh(*args, wav, env=miljö)
    ut = []
    for rad in (r.stdout or "").splitlines():
        m = re.match(r"\s*([\d.]+)\s*--\s*([\d.]+)\s+(speaker_\d+)", rad)
        if m:
            ut.append((float(m.group(1)), float(m.group(2)), m.group(3)))
    if not ut:
        return None, (r.stderr or r.stdout or "diariseringen gav inga turer").strip()[-300:]
    return ut, None


def diar_etiketter(turer, dominant=None, bas=0):
    """Diariseringens talare -> läsbara etiketter, sorterade efter taltid.

    Den som pratar mest först (läraren/mötessledaren blir 'Deltagare 1'), och på
    mikrofonens spår får den mest talföre etiketten 'Du'. 'bas' skjuter numreringen så
    att talare från olika spår inte krockar.
    """
    tid = {}
    for t in turer:
        tid[t[2]] = tid.get(t[2], 0.0) + (t[1] - t[0])
    ut, n = {}, 1
    for i, talare in enumerate(sorted(tid, key=lambda s: -tid[s])):
        if i == 0 and dominant:
            ut[talare] = dominant
        else:
            ut[talare] = f"Deltagare {bas + n}"
            n += 1
    return ut


def talare_vid(turer, etiketter, start, slut):
    """Etiketten för det diariseringssegment som täcker mest av stycket (annars None)."""
    bästa, täckning = None, 0.0
    for t in turer:
        o = min(slut, t[1]) - max(start, t[0])
        if o > täckning:
            bästa, täckning = t[2], o
    if bästa is None or täckning < 0.3 * max(0.1, slut - start):
        return None
    return etiketter.get(bästa)


def märk_segment(segs, turer, etiketter):
    """Sätter talaretikett på varje whisper-segment och behåller spårnumret i etiketten.

    Måste ske FÖRE paragraphs(): slås styckena ihop först kan ett stycke spänna flera
    talare, och då blir tilldelningen en gissning i stället för en mätning.
    """
    ut = []
    for start, slut, who, text in segs:
        talare = talare_vid(turer, etiketter, start, slut)
        nr = who.split("#")[1] if "#" in who else ""
        ut.append((start, slut, f"{talare or who.split('#')[0]}#{nr}", text))
    return ut


