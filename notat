def sh(*args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def modell_sökväg(mid):
    """Var ligger modellen? Nedladdade ligger i MODEL_ROOT/<id>/, systemets i MODEL_DIRS."""
    m = next((x for x in MODELLER if x["id"] == mid), None)
    if not m:
        return None
    p = os.path.join(MODEL_ROOT, mid, m["fil"])
    if os.path.exists(p):
        return p
    for d in MODEL_DIRS:
        if d and os.path.exists(os.path.join(d, m["fil"])):
            return os.path.join(d, m["fil"])
    return None


