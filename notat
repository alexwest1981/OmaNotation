    if m is None:
        print(json.dumps({"ok": False, "error": f"okänd modell: {mid}"}, ensure_ascii=False))
        return 1
    if modell_sökväg(mid):
        print(json.dumps({"ok": True, "id": mid, "redan": True, "sökväg": modell_sökväg(mid)},
                         ensure_ascii=False))
        return 0
    dest_dir = os.path.join(MODEL_ROOT, mid)
    os.makedirs(dest_dir, exist_ok=True)
    dest, tmp = os.path.join(dest_dir, m["fil"]), os.path.join(dest_dir, m["fil"] + ".del")
    try:
        ladda_ner(m["url"], tmp, min_mb=1)
        os.replace(tmp, dest)
    except Exception as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        log(f"hamta {mid} misslyckades: {e}")
        print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}, ensure_ascii=False))
        return 1
    log(f"hamta {mid} klar ({os.path.getsize(dest) >> 20} MB)")
    print(json.dumps({"ok": True, "id": mid, "sökväg": dest, "mb": os.path.getsize(dest) >> 20},
                     ensure_ascii=False))
