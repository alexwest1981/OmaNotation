def cmd_diar_hamta(_args):
    """Hämtar sherpa-onnx + segmentering + embedding (~70 MB) för talaruppdelningen."""
    import tarfile
    os.makedirs(DIAR_ROOT, exist_ok=True)
    try:
        for f in DIAR_FILER:
            if os.path.exists(f["klar"]):
                print(json.dumps({"ok": True, "redan": True, "vad": f["nm"]}, ensure_ascii=False))
                continue
            if f["tar"]:
                tmp = os.path.join(DIAR_ROOT, os.path.basename(f["url"]))
                ladda_ner(f["url"], tmp, min_mb=5)
                ut = tmp + ".ut"
                os.makedirs(ut, exist_ok=True)
                with tarfile.open(tmp, "r:bz2") as t:
                    try:
                        t.extractall(ut, filter="data")
                    except TypeError:                 # python < 3.12
                        t.extractall(ut)
                inre = os.path.join(ut, os.listdir(ut)[0])   # paketet har en toppkatalog
                shutil.copytree(inre, f["mål"], dirs_exist_ok=True)
                shutil.rmtree(ut, ignore_errors=True)
                os.unlink(tmp)
                if os.path.exists(DIAR_BIN):
                    os.chmod(DIAR_BIN, 0o755)
            else:
                os.makedirs(os.path.dirname(f["mål"]), exist_ok=True)
                ladda_ner(f["url"], f["mål"] + ".del", min_mb=5)
                os.replace(f["mål"] + ".del", f["mål"])
            print(json.dumps({"ok": True, "vad": f["nm"], "färdig": diar_finns()}, ensure_ascii=False))
    except Exception as e:
        log(f"diar-hamta misslyckades: {e}")
        print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}, ensure_ascii=False))
        return 1
    log("diar-hamta klar")
    print(json.dumps({"ok": True, "sökväg": DIAR_ROOT, "talare": True}, ensure_ascii=False))
    return 0


