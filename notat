USAGE = __doc__


def main(argv):
    if not argv:
        return cmd_toggle({})
    cmd, rest = argv[0], argv[1:]
    flags = {"_": [a for a in rest if not a.startswith("--")]}
    for a in rest:
        if a.startswith("--"):
            flags[a[2:]] = True
    table = {"start": cmd_start, "stop": cmd_stop, "status": cmd_status,
             "transcribe": cmd_transcribe, "devices": cmd_devices, "toggle": cmd_toggle,
             "valj": cmd_valj, "modeller": cmd_modeller, "modell": cmd_modell,
             "hamta": cmd_hamta, "röster": cmd_röster, "diar-hamta": cmd_diar_hamta}
    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if cmd not in table:
        sys.exit(USAGE)
    return table[cmd](flags)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
