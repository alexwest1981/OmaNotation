SUMMARY_SYS = ("Du sammanfattar utskrifter från möten och föreläsningar på svenska. "
               "Svara i markdown, kort och konkret, utan inledning eller förklaring av vad du gör.")


def ai_config():
    """AI-inställningarna läses ur OmaScribes config, så de följer hans egna val."""
    cfg = {}
    try:
        with open(OMASCRIBE_CFG, encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        pass
    endpoint = os.environ.get("NOTAT_AI_ENDPOINT") or cfg.get("ai_endpoint") or ""
    key = (os.environ.get("NOTAT_AI_KEY") or cfg.get("ai_key")
           or os.environ.get("OMNIROUTE_API_KEY") or "")
    model = os.environ.get("NOTAT_AI_MODEL") or cfg.get("ai_model") or "OmniRoute"
    return endpoint, key, model


def ai_chat(endpoint, key, model, system, user, timeout=180):
    body = json.dumps({"model": model, "messages": [
        {"role": "system", "content": system},
        {"role": "user", "content": user}]}).encode()
    req = urllib.request.Request(
        endpoint.rstrip("/") + "/chat/completions", data=body,
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + key})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())["choices"][0]["message"]["content"].strip()


def chunks(text, size=16000):
    """Delar på styckegräns: en timmes föreläsning ryms inte i ett anrop."""
    out, cur = [], ""
    for para in text.split("\n\n"):
        if cur and len(cur) + len(para) > size:
            out.append(cur)
            cur = ""
        cur += para + "\n\n"
    if cur.strip():
        out.append(cur)
    return out


def summarize(transcript):
    """(sammanfattning, fel). Fel får aldrig stoppa dokumentet."""
    endpoint, key, model = ai_config()
    if not endpoint:
        return None, "ingen AI-endpoint konfigurerad"
    try:
        parts = chunks(transcript)
        if len(parts) == 1:
            txt = ai_chat(endpoint, key, model, SUMMARY_SYS,
                          "Sammanfatta: kort översikt i 3-5 punkter, sedan 'Beslut', "
                          "'Uppgifter' och 'Nyckelbegrepp' om sådant nämns.\n\n" + parts[0])
        else:
            delar = [ai_chat(endpoint, key, model, SUMMARY_SYS,
                             f"Detta är del {i} av {len(parts)} av en utskrift. Sammanfatta avsnittet "
                             "i punkter (ta med beslut, uppgifter, datum, namn).\n\n" + p)
                     for i, p in enumerate(parts, 1)]
            txt = ai_chat(endpoint, key, model, SUMMARY_SYS,
                          "Slå ihop dessa delsammanfattningar till EN: kort översikt i 3-5 punkter, "
                          "sedan 'Beslut', 'Uppgifter' och 'Nyckelbegrepp'.\n\n" + "\n\n".join(delar))
        return txt, None
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"


def transcribe_dir(rawdir, seconds, sammanfatta=True):
    if not os.path.isdir(rawdir):
        sys.exit(f"notat: {rawdir} finns inte")
    meta = {}
    try:
        with open(os.path.join(rawdir, "session.json"), encoding="utf-8") as f:
            meta = json.load(f)
    except Exception:
        pass
    tracks = [(t["file"], t.get("label", "Mötet"), t.get("desc") or t["file"])
              for t in (meta.get("tracks") or []) if t.get("file")]
    if not tracks:      # äldre inspelning, eller dir där sessionen försvunnit
        tracks = [("remote.wav", "Mötet", "ljudutgången"), ("mic.wav", "Du", "mikrofonen")]

    def duration(path):
        r = sh("ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path)
        try:
            return float(r.stdout.strip())
        except ValueError:
            return 0.0

    if not seconds:      # omtranskribering: längden finns i filen, inte i någon session
        seconds = int(meta.get("seconds") or 0)
    if not seconds:
        for f, _l, _d in tracks:
            p = os.path.join(rawdir, f)
            if os.path.exists(p):
                seconds = int(duration(p))
                break

    model = find_model()
    vad = find_vad()
    röster = röster_på()
    antal_talare = int(notat_config().get("antal_talare") or 0)
    all_segs = []
    failures = []
    kallor = []
    envs = {}
    dian = {}          # spårnummer -> talarturer
    etiketter = {}     # spårnummer -> {speaker_00: 'Deltagare 1', ...}
    spårtyp = {}       # spårnummer -> 'ut' (mötet) eller 'in' (mikrofon)
    talarräknare = 0
    for i, (f, who, desc) in enumerate(tracks, 1):
        p = os.path.join(rawdir, f)
        if not os.path.exists(p):
            failures.append(f"{desc}: ingen fil (enheten dog under inspelningen)")
            continue
        spårtyp[i] = "ut" if who.startswith("Mötet") else "in"
        dur = duration(p)
        if dur >= 1:
            kallor.append(f"{desc} ({mmss(dur)})")
        envs[i] = envelope(p)
        if röster and dur >= 15:
            turer, diarfel = diar_turer(p, antal_talare)
            if turer:
                stämplar = diar_etiketter(turer, dominant="Du" if who.startswith("Du") else None,
                                          bas=talarräknare)
                dian[i] = turer
                etiketter[i] = stämplar
                talarräknare += sum(1 for v in stämplar.values() if v.startswith("Deltagare"))
            else:
                failures.append(f"{desc}: talaruppdelningen misslyckades ({diarfel})")
                log(f"diarisering av {f}: {diarfel}")
        data, err = whisper(p, os.path.join(rawdir, os.path.splitext(f)[0]), model, vad)
        if err:
            failures.append(f"{desc}: {err}")
            continue
        # enhetens nummer i talaretiketten: två mikrofoner har samma "Du" men är olika spår
        segs = segments(data, f"{who}#{i}")
        if etiketter.get(i):
            # talaren sätts per segment: först därefter slås stycken ihop, annars kan ett
            # stycke spänna flera röster och etiketten blir en gissning
            segs = märk_segment(segs, dian[i], etiketter[i])
        all_segs += segs
    all_segs.sort(key=lambda s: s[0])
    paras = dedupe(paragraphs(all_segs), envs)

    stamp = os.path.basename(rawdir)
    try:   # de första 16 tecknen är tidsstämpeln även när mappen fick "-2"-svans
        when = datetime.strptime(stamp[:16], "%Y-%m-%d %H-%M").strftime("%Y-%m-%d %H:%M")
    except ValueError:
        when = stamp
    title = f"Möte {stamp}"
    lines = [f"# {title}", "",
             f"**Inspelat:** {when} · {mmss(seconds)} · "
             f"{'VAD' if vad else 'ingen VAD'} · {'röster · ' if etiketter else ''}"
             f"modell {modell_namn(model)}", ""]
    if kallor:
        lines += [f"**Källor:** {' · '.join(kallor)}", ""]
    if etiketter:
        använda = sorted({v for m in etiketter.values() for v in m.values()},
                         key=lambda s: (not s.startswith("Du"), s))
        lines += [f"**Talare:** {' · '.join(använda)} — rösterna skiljs åt lokalt, "
                  "numren gäller den här inspelningen", ""]
    lines += [f"**Rå ljud:** `{rawdir}`", ""]
    if not vad:
        lines += ["> [!warning] Ingen VAD-modell hittad - tysta partier kan bli påhittad text", ""]
    eko, antal_mic = eko_stycken(paras, envs, spårtyp)
    if eko:
        lines += [f"> [!warning] Mötets ljud hördes i rummet ({eko} av {antal_mic} mikrofonstycken "
                  "är samma ljud som utgången): samma diskussion står därför två gånger. "
                  "Hörlurar - eller ekodämpning i mötesappen - ger en ren text.", ""]
    if failures:
        lines += ["> [!warning] Transkriberingen är ofullständig", *[f"> {f}" for f in failures], ""]
    if not paras:
        lines += ["_Inget tal hittades i inspelningen._", ""]
    lines += ["## Transkription", ""]
    for start, _end, who, text in paras:
        lines.append(f"**[{mmss(start)}] {who.split('#')[0]}:** {text}")
        lines.append("")
    lines += ["## Egna anteckningar", "", ""]
    content = "\n".join(lines)

    dest = os.path.join(vault_root(), VAULT_FOLDER)
    os.makedirs(dest, exist_ok=True)
    path = os.path.join(dest, f"{title}.md")
    n = 2
    while os.path.exists(path):
        path = os.path.join(dest, f"{title} {n}.md")
        n += 1
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    notify("Anteckning klar", f"{os.path.basename(path)} · {len(paras)} stycken")

    # Sammanfattningen hämtas EFTER att dokumentet skrivits: en seg eller död
    # AI-tjänst får aldrig kosta dig utskriften.
    if sammanfatta and paras:
        transcript = "\n".join(f"[{mmss(s)}] {who.split('#')[0]}: {text}" for s, _e, who, text in paras)
        log(f"sammanfattar {len(transcript)} tecken via AI ...")
        txt, err = summarize(transcript)
        if txt:
            try:
                with open(path, encoding="utf-8") as f:
                    current = f.read()
                marker = "## Transkription"
                if marker in current:
                    head, rest = current.split(marker, 1)
                    with open(path, "w", encoding="utf-8") as f:
                        f.write(head + "## Sammanfattning\n\n" + txt + "\n\n" + marker + rest)
                log(f"sammanfattning inlagd ({len(txt)} tecken)")
            except OSError as e:
                log(f"kunde inte lägga in sammanfattningen: {e}")
        else:
            log(f"ingen sammanfattning: {err}")
            notify("Ingen sammanfattning", err or "okänt fel")
    return path


def modell_namn(path):
    """Modellens namn till dokumentet - filnamnet 'ggml-model.bin' säger ingenting."""
    for m in MODELLER:
        if modell_sökväg(m["id"]) == path:
            return m["id"]
    return os.path.basename(path)


def cmd_transcribe(args):
    rawdir = args["_"][0] if args["_"] else None
    if not rawdir:
