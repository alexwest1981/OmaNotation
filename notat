SKIP_HINTS = ("null", "notat_test", "dummy")
CONFIG = os.path.join(HOME, ".config/notat/config.json")
EXCLUDED = []      # filled by device_list(): devices that were skipped, so it shows


# The config keys were Swedish until 1.1.1. An existing ~/.config/notat/config.json is read
# through this map so a device list or model choice does not silently disappear; the English
# key wins when both are present, and everything written back uses the English name.
LEGACY_KEYS = {"exclude": "uteslut", "model": "modell", "speakers": "röster",
               "speaker_count": "antal_talare", "vault": "valv", "names": "namn"}


def notat_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        return {}
    for new, old in LEGACY_KEYS.items():
        if new not in cfg and old in cfg:
            cfg[new] = cfg[old]
    return cfg


def is_excluded(node, desc, patterns):
    text = f"{node} {desc}".lower()
    return any(m.lower() in text for m in patterns)


def pactl_json(kind):
    r = sh("pactl", "-f", "json", "list", kind)
    try:
        return json.loads(r.stdout or "[]")
    except ValueError:
        return []


def clean_description(desc):
    d = (desc or "").strip()
    return d[len("Monitor of "):].strip() if d.startswith("Monitor of ") else d


def all_devices():
    """All devices that can be selected, with a selected flag (excluded ones are listed too)."""
    patterns = notat_config().get("exclude") or []
    out = []
    for s in pactl_json("sinks"):
        name = (s.get("name") or "").strip()
        if not name or any(h in name.lower() for h in SKIP_HINTS):
            continue
        desc = clean_description(s.get("description")) or name
        out.append({"kind": "out", "node": name + ".monitor", "speaker": "Meeting",
                    "description": desc, "selected": not is_excluded(name, desc, patterns)})
    for s in pactl_json("sources"):
        name = (s.get("name") or "").strip()
        if not name or ".monitor" in name or any(h in name.lower() for h in SKIP_HINTS):
            continue
        desc = clean_description(s.get("description")) or name
        out.append({"kind": "in", "node": name, "speaker": "You",
                    "description": desc, "selected": not is_excluded(name, desc, patterns)})
    return out


def device_list():
    """Every audio output and every audio input — not just the default devices.

    'All audio' means: if Zoom plays out through the headphones while the video goes to the
    speakers, or you switch mic mid-way, both are captured. One device per ffmpeg, so a dead
    device (unplugged USB, busy HDMI) does not bring down the rest.
    """
    sink_env, source_env = os.environ.get("NOTAT_SINK"), os.environ.get("NOTAT_SOURCE")
    if sink_env or source_env:      # locked/tested mode: exactly two devices
        sink = sink_env or sh("pactl", "get-default-sink").stdout.strip()
        source = source_env or sh("pactl", "get-default-source").stdout.strip()
        if not sink or not source:
            sys.exit("notat: pactl is not answering (is PipeWire running?)")
        remote = sink if sink.endswith(".monitor") else sink + ".monitor"
        return [("out", remote, "Meeting", "selected output"), ("in", source, "You", "selected input")]
    EXCLUDED.clear()
    tracks = []
    for d in all_devices():
        if d["selected"]:
            tracks.append((d["kind"], d["node"], d["speaker"], d["description"]))
        else:
            kind = "output" if d["kind"] == "out" else "input"
            EXCLUDED.append(f"{d['description']} ({kind})")
    if not tracks:
        sys.exit("notat: found no audio devices (pactl -f json list sinks/sources)")
    return tracks


def cmd_select(args):
    """Turns a device off/on in config, or everything on: notat select <node> | notat select all"""
    target = args["_"][0] if args["_"] else "all"
    cfg = notat_config()
    patterns = list(cfg.get("exclude") or [])
    if target == "all":
        cfg["exclude"] = []
    else:
        hit = next((d for d in all_devices() if d["node"] == target), None)
        if hit is None:
            print(json.dumps({"ok": False, "error": f"unknown device: {target}"}, ensure_ascii=False))
            return 1
        key = target[:-len(".monitor")] if target.endswith(".monitor") else target
        text = f"{key} {hit['description']}".lower()
        rest = [m for m in patterns if m.lower() not in text]     # matching patterns removed
        # selected = switched on now: the click should turn it OFF
        cfg["exclude"] = rest + [key] if hit["selected"] else rest
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except OSError as e:
        print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
        return 1
    log(f"select {target} -> exclude={cfg['exclude']}")
    print(json.dumps({"ok": True, "exclude": cfg["exclude"], "devices": all_devices()},
                     ensure_ascii=False))
    return 0


def vault_root():
    """Where the documents end up: 'vault' in config first, then OmaScribe's vault, otherwise our own folder."""
    from_env = os.environ.get("NOTAT_VAULT")
    if from_env:
        return os.path.expanduser(from_env)
    own = notat_config().get("vault")
    if own:
        return os.path.expanduser(own)
    try:
        with open(OMASCRIBE_CFG, encoding="utf-8") as f:
            root = json.load(f).get("vault_root")
        if root:
            return root
    except Exception:
