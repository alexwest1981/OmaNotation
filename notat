#!/usr/bin/env python3
"""notat - spelar in båda ljudsidorna av ett möte/föreläsning och gör ett dokument av det.

  notat            startar om inget spelas in, stoppar + transkriberar annars
  notat start      starta inspelning
  notat stop       stoppa, transkribera, skriv dokument
  notat status     --json för baren
  notat transcribe <mapp>   transkribera en tidigare inspelning igen
  notat devices    visa vilka enheter som används
"""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

HOME = os.path.expanduser("~")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATE = os.path.join(RUNTIME, "notat")
SESSION = os.path.join(STATE, "session.json")
LOG = os.path.join(HOME, ".local/share/notat/notat.log")
RAW_ROOT = os.path.join(HOME, ".local/share/notat/raw")
WHISPER = shutil.which("whisper-cli") or os.path.join(HOME, ".local/bin/whisper-cli")
MODEL_DIRS = [
    os.environ.get("NOTAT_MODEL_DIR", ""),
    os.path.join(HOME, ".local/share/notat/models"),
    os.path.join(HOME, "Work/novacut/models"),
]
FOLDERS = ["small", "base", "tiny"]          # kvalitet först; small mätt bättre än base på svenska
VAD_NAMES = ["ggml-silero-v5.1.2.bin", "ggml-silero-v5.0.0.bin"]
LANG = os.environ.get("NOTAT_LANG", "auto")
OMASCRIBE_CFG = os.path.join(HOME, ".config/omascribe/config.json")
VAULT_FALLBACK = os.path.join(HOME, "Documents/OmaScribe Vault")
VAULT_FOLDER = "Inspelningar"


# ------------------------------------------------------------------ hjälpare

def sh(*args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def find_model():
    for d in MODEL_DIRS:
        if not d:
            continue
        for name in FOLDERS:
            p = os.path.join(d, f"ggml-{name}.bin")
            if os.path.exists(p):
                return p
    sys.exit("notat: hittar ingen whisper-modell (sätt NOTAT_MODEL_DIR)")


def find_vad():
    for d in MODEL_DIRS:
        if not d:
            continue
        for name in VAD_NAMES:
            p = os.path.join(d, name)
            if os.path.exists(p):
                return p
    return None


SKIP_HINTS = ("null", "notat_test", "dummy")


def pactl_json(kind):
    r = sh("pactl", "-f", "json", "list", kind)
    try:
        return json.loads(r.stdout or "[]")
    except ValueError:
        return []


def clean_desc(desc):
    d = (desc or "").strip()
    return d[len("Monitor of "):].strip() if d.startswith("Monitor of ") else d


def device_list():
    """Varje ljudutgång och varje ljudingång — inte bara standardenheterna.

    'Allt ljud' betyder: spelar Zoom ut i hörlurarna medan videon går i högtalarna,
    eller byter du mic mitt i, fångas båda. En enhet per ffmpeg, så en död enhet
    (urkopplad USB, upptagen HDMI) fäller inte resten.
    """
    sink_env, source_env = os.environ.get("NOTAT_SINK"), os.environ.get("NOTAT_SOURCE")
    if sink_env or source_env:      # låst/testat läge: exakt två enheter
        sink = sink_env or sh("pactl", "get-default-sink").stdout.strip()
        source = source_env or sh("pactl", "get-default-source").stdout.strip()
        if not sink or not source:
            sys.exit("notat: pactl svarar inte (PipeWire igång?)")
        remote = sink if sink.endswith(".monitor") else sink + ".monitor"
        return [("ut", remote, "Mötet", "vald utgång"), ("in", source, "Du", "vald ingång")]
    tracks = []
    for s in pactl_json("sinks"):
        name = (s.get("name") or "").strip()
        if name and not any(h in name.lower() for h in SKIP_HINTS):
            tracks.append(("ut", name + ".monitor", "Mötet", clean_desc(s.get("description")) or name))
    for s in pactl_json("sources"):
        name = (s.get("name") or "").strip()
        if name and ".monitor" not in name and not any(h in name.lower() for h in SKIP_HINTS):
            tracks.append(("in", name, "Du", clean_desc(s.get("description")) or name))
    if not tracks:
        sys.exit("notat: hittar inga ljudenheter (pactl -f json list sinks/sources)")
    return tracks


def vault_root():
    try:
        with open(OMASCRIBE_CFG, encoding="utf-8") as f:
            root = json.load(f).get("vault_root") or VAULT_FALLBACK
    except Exception:
        root = VAULT_FALLBACK
    return root


def load_session():
    try:
        with open(SESSION, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def alive(pid):
    """Lever processen, och är det fortfarande vår ffmpeg? (pid återanvänds annars)"""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return b"ffmpeg" in f.read()
    except OSError:
        return False


def session_pids(sess):
    if not sess:
        return []
    pids = [t.get("pid") for t in sess.get("tracks") or []]
    if sess.get("pid"):
        pids.append(sess["pid"])          # äldre sessioner
    return [p for p in pids if p]


def running(sess):
    """True så länge minst en av inspelningarna lever."""
    return any(alive(p) for p in session_pids(sess))


def log(msg):
    """Liten händelselogg: vem (förälder) gjorde vad - annars går det inte att utreda."""
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        ppid = os.getppid()
        try:
            with open(f"/proc/{ppid}/cmdline", "rb") as f:
                parent = f.read().replace(b"\0", b" ").decode(errors="replace").strip()[:120]
        except OSError:
            parent = "?"
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat(timespec='seconds')} {msg} (förälder {ppid}: {parent})\n")
    except OSError:
        pass


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "notat", title, body])


# ------------------------------------------------------------------ start/stopp

def cmd_start(_args):
    sess = load_session()
    if running(sess):
        print(json.dumps({"ok": False, "error": "spelar redan in", "since": sess["started"]}))
        return 0
    tracks = device_list()
    stamp = datetime.now().strftime("%Y-%m-%d %H-%M")
    outdir = os.path.join(RAW_ROOT, stamp)
    n = 2
    while os.path.exists(os.path.join(outdir, "session.json")):
        outdir = os.path.join(RAW_ROOT, f"{stamp}-{n}")   # två inspelningar samma minut
        n += 1
    os.makedirs(outdir, exist_ok=True)
    started = []
    for i, (kind, node, label, desc) in enumerate(tracks, 1):
        name = f"{kind}{i}"
        fflog = open(os.path.join(outdir, name + ".log"), "w")
        proc = subprocess.Popen([
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning",
            "-f", "pulse", "-i", node,
            "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", os.path.join(outdir, name + ".wav"),
        ], stdout=fflog, stderr=fflog, stdin=subprocess.DEVNULL, start_new_session=True)
        started.append({"file": name + ".wav", "node": node, "label": label,
                        "desc": desc, "pid": proc.pid})
    time.sleep(1.0)
    live = [t for t in started if alive(t["pid"])]
    if not live:
        why = []
        for t in started:
            try:
                with open(os.path.join(outdir, t["file"].replace(".wav", ".log")),
                          encoding="utf-8", errors="replace") as f:
                    tail = f.read()[-200:].strip()
            except OSError:
                tail = "?"
            why.append(f"{t['desc']}: {tail}")
        # ponytail: en död enhet får inte tysta de andra - bara noll levande är fel
        print(json.dumps({"ok": False, "error": "ingen enhet kunde spelas in: " + " | ".join(why)},
                         ensure_ascii=False))
        return 1
    info = {"started": time.time(), "dir": outdir, "tracks": live, "pid": live[0]["pid"]}
    os.makedirs(STATE, exist_ok=True)
    for path in (SESSION, os.path.join(outdir, "session.json")):
        with open(path, "w", encoding="utf-8") as f:
            json.dump(info, f)
    names = ", ".join(t["desc"] for t in live)
    notify("Spelar in", f"{len(live)} enheter: {names[:70]}")
    log(f"start {outdir} {len(live)}/{len(started)} enheter: {names}")
    print(json.dumps({"ok": True, "dir": outdir,
                      "tracks": [{"desc": t["desc"], "node": t["node"]} for t in live]},
                     ensure_ascii=False))
    return 0


def stop_ffmpeg(sess):
    pids = [p for p in session_pids(sess) if alive(p)]
    for pid in pids:
        os.kill(pid, signal.SIGINT)          # ffmpeg skriver klart wav-huvudet
    for _ in range(100):
        if not any(alive(p) for p in pids):
            return True
        time.sleep(0.1)
    for pid in pids:
        if alive(pid):
            os.kill(pid, signal.SIGTERM)
    return True


def cmd_stop(args):
    sess = load_session()
    if not sess:
        print(json.dumps({"ok": False, "error": "ingen inspelning"}))
        return 1
    was_live = running(sess)
    stop_ffmpeg(sess)
    seconds = int((sess.get("stopped") or time.time()) - sess["started"]) if not was_live else int(time.time() - sess["started"])
    try:
        os.unlink(SESSION)
    except OSError:
        pass
    if seconds < 3 and not args.get("force"):
        notify("Ingen inspelning", "Kortare än 3 sekunder - inget dokument skapades")
        log(f"stop avbruten: bara {seconds}s")
        print(json.dumps({"ok": False, "error": "för kort", "seconds": seconds}))
        return 1
    path = transcribe_dir(sess["dir"], seconds, sammanfatta=not args.get("no-summary"))
    log(f"stop efter {seconds}s -> {path}")
    print(json.dumps({"ok": bool(path), "note": path, "seconds": seconds}))
    return 0 if path else 1


# ------------------------------------------------------------------ transkribering

def whisper(wav, outbase, model, vad):
    args = [WHISPER, "-m", model, "-f", wav, "-l", LANG, "-oj", "-of", outbase, "-t", "12", "-nt"]
    if vad:
        args += ["--vad", "-vm", vad]
    r = sh(*args)
    path = outbase + ".json"
    if not os.path.exists(path):
        return None, (r.stderr or r.stdout or "whisper gav ingen utdata").strip()[-400:]
    with open(path, encoding="utf-8") as f:
        return json.load(f), None


def segments(data, speaker):
    """whisper-clis JSON -> [(start_sek, slut_sek, talare, text)]"""
    out = []
    for seg in (data or {}).get("transcription", []):
        text = (seg.get("text") or "").strip()
        if not text:
            continue
        off = seg.get("offsets") or {}
        start = (off.get("from") or 0) / 1000.0
        end = (off.get("to") or 0) / 1000.0
        if "[" in text or "(musik" in text.lower():     # whisper brusmarkörer
            continue
        out.append((start, end, speaker, text))
    return out


def paragraphs(segs, gap=3.0, maxlen=400):
    """Slår ihop intilliggande rader från samma talare - läsbart dokument."""
    out = []
    for start, end, who, text in segs:
        if out and out[-1][2] == who and start - out[-1][1] < gap and len(out[-1][3]) < maxlen:
            out[-1][1] = end
            out[-1][3] += " " + text
        else:
            out.append([start, end, who, text])
    return out


def envelope(path, hop_ms=20):
    """RMS per 20 ms - ett kuvert att jämföra ljud med.

    ponytail: ren Python-loop över samplen (~6 s per timme och spår). numpy om det
    blir besvärande, men det finns inte garanterat på maskinen.
    """
    import array
    import wave
    try:
        with wave.open(path, "rb") as w:
            if w.getsampwidth() != 2:
                return None, 0.0
            rate = w.getframerate()
            raw = w.readframes(w.getnframes())
    except (wave.Error, OSError, EOFError):
        return None, 0.0
    a = array.array("h")
    a.frombytes(raw[:len(raw) // 2 * 2])
    step = max(1, int(rate * hop_ms / 1000))
    env = [max((abs(v) for v in a[i:i + step]), default=0)
           for i in range(0, len(a) - step + 1, step)]
    return env, hop_ms / 1000.0


def korr(a, b, max_lag=50):
    """Högsta normaliserade korrelationen mellan två kuvert, med eftersökning av fördröjning.

    ±max_lag fönster täcker att ljudet tar olika lång väg till en mikrofon och till
    utgångens monitor.
    """
    n = min(len(a), len(b))
    if n < 5:
        return 0.0
    a, b = a[:n], b[:n]
    ma, mb = sum(a) / n, sum(b) / n
    da, db = [x - ma for x in a], [y - mb for y in b]
    bäst = 0.0
    for lag in range(-max_lag, max_lag + 1):
        x, y = (da[:n - lag], db[lag:]) if lag >= 0 else (da[-lag:], db[:n + lag])
        if len(x) < 5:
            continue
        num = sum(p * q for p, q in zip(x, y))
        den = (sum(p * p for p in x) ** 0.5) * (sum(q * q for q in y) ** 0.5)
        if den > 0:
            bäst = max(bäst, num / den)
    return bäst


def track_no(par):
    try:
        return int(par[2].split("#")[1])
    except (IndexError, ValueError):
        return 0


def dedupe(paras, envs, ratio=0.85, overlap_frac=0.5):
    """Samma ljud fångat av flera enheter ska inte stå flera gånger.

    Texten duger inte som mått: whisper skriver olika ord för samma mening beroende på
    vilken mikrofon som hörde den (mätt: "Vi börjar om den här kursen" mot "Någonting i
    början av kursen" - 0,4 i textlikhet för samma sekund). Kuverten däremot är samma
    ljud. Den starkaste kopian behålls - linjeljudet ligger högst när mötet hörs i
    högtalarna, din egen mikrofon när du pratar.
    """
    def nivå(par):
        env, hop = envs.get(track_no(par), (None, 0))
        if not env:
            return 0.0
        seg = env[int(par[0] / hop):int(par[1] / hop)] or [0]
        return sum(seg) / len(seg)

    keep = []
    for p in paras:
        duplikat = None
        for q in keep:
            if p[2] == q[2]:                       # samma enhet -> aldrig dubblett
                continue
            kortast = min(p[1] - p[0], q[1] - q[0])
            if kortast <= 0 or min(p[1], q[1]) - max(p[0], q[0]) < overlap_frac * kortast:
                continue
            envp, hopp = envs.get(track_no(p), (None, 0))
            envq, hopq = envs.get(track_no(q), (None, 0))
            if not envp or not envq or hopp != hopq:
                continue
            a = envp[int(p[0] / hopp):int(p[1] / hopp)]
            b = envq[int(q[0] / hopq):int(q[1] / hopq)]
            if korr(a, b) >= ratio:
                duplikat = q
                break
        if duplikat is None:
            keep.append(p)
        elif nivå(p) > nivå(duplikat):
            keep[keep.index(duplikat)] = p
    keep.sort(key=lambda p: p[0])
    return keep


def eko_stycken(paras, envs, ratio=0.5):
    """Räknar mikrofonstycken som hörde utgången (dvs mötet gick i högtalarna).

    Mätt på en riktig körning: mikrofon mot utgång gav 0,64-0,70 i hel-stycke-
    korrelation när ljudet hördes i rummet, medan olika ljud samtidigt ligger under
    0,3. Gränsen 0,5 skiljer de två fallen.
    """
    ut = [p for p in paras if p[2].startswith("Mötet")]
    mic = [p for p in paras if p[2].startswith("Du")]
    träffar = 0
    for p in mic:
        for q in ut:
            kortast = min(p[1] - p[0], q[1] - q[0])
            if kortast <= 0 or min(p[1], q[1]) - max(p[0], q[0]) < 0.5 * kortast:
                continue
            envp, hopp = envs.get(track_no(p), (None, 0))
            envq, hopq = envs.get(track_no(q), (None, 0))
            if not envp or not envq or hopp != hopq:
                continue
            if korr(envp[int(p[0] / hopp):int(p[1] / hopp)],
                    envq[int(q[0] / hopq):int(q[1] / hopq)]) >= ratio:
                träffar += 1
                break
    return träffar, len(mic)


def mmss(sec):
    sec = int(sec)
    return f"{sec // 60:02d}:{sec % 60:02d}"


# ------------------------------------------------------------------ sammanfattning

SUMMARY_SYS = ("Du sammanfattar utskrifter från möten och föreläsningar på svenska. "
               "Svara i markdown, kort och konkret, utan inledning eller förklaring av vad du gör.")


def ai_config():
    """AI-inställningarna läses ur OmaScribes config, så de följer hans egna val."""
    cfg = {}
    try:
        with open(OMASCRIBE_CFG, encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        pass
    endpoint = os.environ.get("NOTAT_AI_ENDPOINT") or cfg.get("ai_endpoint") or ""
    key = (os.environ.get("NOTAT_AI_KEY") or cfg.get("ai_key")
           or os.environ.get("OMNIROUTE_API_KEY") or "")
    model = os.environ.get("NOTAT_AI_MODEL") or cfg.get("ai_model") or "OmniRoute"
    return endpoint, key, model


def ai_chat(endpoint, key, model, system, user, timeout=180):
    body = json.dumps({"model": model, "messages": [
        {"role": "system", "content": system},
        {"role": "user", "content": user}]}).encode()
    req = urllib.request.Request(
        endpoint.rstrip("/") + "/chat/completions", data=body,
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + key})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())["choices"][0]["message"]["content"].strip()


def chunks(text, size=16000):
    """Delar på styckegräns: en timmes föreläsning ryms inte i ett anrop."""
    out, cur = [], ""
    for para in text.split("\n\n"):
        if cur and len(cur) + len(para) > size:
            out.append(cur)
            cur = ""
        cur += para + "\n\n"
    if cur.strip():
        out.append(cur)
    return out


def summarize(transcript):
    """(sammanfattning, fel). Fel får aldrig stoppa dokumentet."""
    endpoint, key, model = ai_config()
    if not endpoint:
        return None, "ingen AI-endpoint konfigurerad"
    try:
        parts = chunks(transcript)
        if len(parts) == 1:
            txt = ai_chat(endpoint, key, model, SUMMARY_SYS,
                          "Sammanfatta: kort översikt i 3-5 punkter, sedan 'Beslut', "
                          "'Uppgifter' och 'Nyckelbegrepp' om sådant nämns.\n\n" + parts[0])
        else:
            delar = [ai_chat(endpoint, key, model, SUMMARY_SYS,
                             f"Detta är del {i} av {len(parts)} av en utskrift. Sammanfatta avsnittet "
                             "i punkter (ta med beslut, uppgifter, datum, namn).\n\n" + p)
                     for i, p in enumerate(parts, 1)]
            txt = ai_chat(endpoint, key, model, SUMMARY_SYS,
                          "Slå ihop dessa delsammanfattningar till EN: kort översikt i 3-5 punkter, "
                          "sedan 'Beslut', 'Uppgifter' och 'Nyckelbegrepp'.\n\n" + "\n\n".join(delar))
        return txt, None
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"


def transcribe_dir(rawdir, seconds, sammanfatta=True):
    if not os.path.isdir(rawdir):
        sys.exit(f"notat: {rawdir} finns inte")
    meta = {}
    try:
        with open(os.path.join(rawdir, "session.json"), encoding="utf-8") as f:
            meta = json.load(f)
    except Exception:
        pass
    tracks = [(t["file"], t.get("label", "Mötet"), t.get("desc") or t["file"])
              for t in (meta.get("tracks") or []) if t.get("file")]
    if not tracks:      # äldre inspelning, eller dir där sessionen försvunnit
        tracks = [("remote.wav", "Mötet", "ljudutgången"), ("mic.wav", "Du", "mikrofonen")]

    def duration(path):
        r = sh("ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path)
        try:
            return float(r.stdout.strip())
        except ValueError:
            return 0.0

    if not seconds:      # omtranskribering: längden finns i filen, inte i någon session
        seconds = int(meta.get("seconds") or 0)
    if not seconds:
        for f, _l, _d in tracks:
            p = os.path.join(rawdir, f)
            if os.path.exists(p):
                seconds = int(duration(p))
                break

    model = find_model()
    vad = find_vad()
    all_segs = []
    failures = []
    kallor = []
    envs = {}
    for i, (f, who, desc) in enumerate(tracks, 1):
        p = os.path.join(rawdir, f)
        if not os.path.exists(p):
            failures.append(f"{desc}: ingen fil (enheten dog under inspelningen)")
            continue
        if duration(p) >= 1:
            kallor.append(f"{desc} ({mmss(duration(p))})")
        envs[i] = envelope(p)
        data, err = whisper(p, os.path.join(rawdir, os.path.splitext(f)[0]), model, vad)
        if err:
            failures.append(f"{desc}: {err}")
            continue
        # enhetens nummer i talaretiketten: två mikrofoner har samma "Du" men är olika spår
        all_segs += segments(data, f"{who}#{i}")
    all_segs.sort(key=lambda s: s[0])
    paras = dedupe(paragraphs(all_segs), envs)

    stamp = os.path.basename(rawdir)
    try:   # de första 16 tecknen är tidsstämpeln även när mappen fick "-2"-svans
        when = datetime.strptime(stamp[:16], "%Y-%m-%d %H-%M").strftime("%Y-%m-%d %H:%M")
    except ValueError:
        when = stamp
    title = f"Möte {stamp}"
    lines = [f"# {title}", "",
             f"**Inspelat:** {when} · {mmss(seconds)} · "
             f"{'VAD' if vad else 'ingen VAD'} · modell {os.path.basename(model)}", ""]
    if kallor:
        lines += [f"**Källor:** {' · '.join(kallor)}", ""]
    lines += [f"**Rå ljud:** `{rawdir}`", ""]
    if not vad:
        lines += ["> [!warning] Ingen VAD-modell hittad - tysta partier kan bli påhittad text", ""]
    eko, antal_mic = eko_stycken(paras, envs)
    if eko:
        lines += [f"> [!warning] Mötets ljud hördes i rummet ({eko} av {antal_mic} mikrofonstycken "
                  "är samma ljud som utgången): samma diskussion står därför två gånger. "
                  "Hörlurar - eller ekodämpning i mötesappen - ger en ren text.", ""]
    if failures:
        lines += ["> [!warning] Transkriberingen är ofullständig", *[f"> {f}" for f in failures], ""]
    if not paras:
        lines += ["_Inget tal hittades i inspelningen._", ""]
    lines += ["## Transkription", ""]
    for start, _end, who, text in paras:
        lines.append(f"**[{mmss(start)}] {who.split('#')[0]}:** {text}")
        lines.append("")
    lines += ["## Egna anteckningar", "", ""]
    content = "\n".join(lines)

    dest = os.path.join(vault_root(), VAULT_FOLDER)
    os.makedirs(dest, exist_ok=True)
    path = os.path.join(dest, f"{title}.md")
    n = 2
    while os.path.exists(path):
        path = os.path.join(dest, f"{title} {n}.md")
        n += 1
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    notify("Anteckning klar", f"{os.path.basename(path)} · {len(paras)} stycken")

    # Sammanfattningen hämtas EFTER att dokumentet skrivits: en seg eller död
    # AI-tjänst får aldrig kosta dig utskriften.
    if sammanfatta and paras:
        transcript = "\n".join(f"[{mmss(s)}] {who.split('#')[0]}: {text}" for s, _e, who, text in paras)
        log(f"sammanfattar {len(transcript)} tecken via AI ...")
        txt, err = summarize(transcript)
        if txt:
            try:
                with open(path, encoding="utf-8") as f:
                    current = f.read()
                marker = "## Transkription"
                if marker in current:
                    head, rest = current.split(marker, 1)
                    with open(path, "w", encoding="utf-8") as f:
                        f.write(head + "## Sammanfattning\n\n" + txt + "\n\n" + marker + rest)
                log(f"sammanfattning inlagd ({len(txt)} tecken)")
            except OSError as e:
                log(f"kunde inte lägga in sammanfattningen: {e}")
        else:
            log(f"ingen sammanfattning: {err}")
            notify("Ingen sammanfattning", err or "okänt fel")
    return path


def cmd_transcribe(args):
    rawdir = args["_"][0] if args["_"] else None
    if not rawdir:
        sys.exit("notat transcribe <mapp med remote.wav/mic.wav>")
    meta = {}
    try:
        with open(os.path.join(rawdir, "session.json"), encoding="utf-8") as f:
            meta = json.load(f)
    except Exception:
        pass
    print(transcribe_dir(rawdir, meta.get("seconds", 0), sammanfatta=not args.get("no-summary")))
    return 0


# ------------------------------------------------------------------ status

def cmd_status(args):
    sess = load_session()
    live = running(sess)
    info = {"recording": live, "seconds": 0, "dir": None, "started": None}
    if sess:
        info["dir"] = sess.get("dir")
        info["started"] = datetime.fromtimestamp(sess["started"]).strftime("%H:%M")
        if live:
            info["seconds"] = int(time.time() - sess["started"])
    if args.get("json"):
        print(json.dumps(info))
    else:
        print(f"{'SPELAR IN ' + mmss(info['seconds']) if live else 'spelar inte in'}"
              + (f"  ({info['dir']})" if live else ""))
    return 0


def cmd_devices(_args):
    print(json.dumps({"enheter": [{"typ": k, "nod": n, "talare": l, "beskrivning": d}
                                  for k, n, l, d in device_list()],
                      "model": find_model(), "vad": find_vad(),
                      "vault": os.path.join(vault_root(), VAULT_FOLDER)},
                     ensure_ascii=False, indent=2))
    return 0


def cmd_toggle(_args):
    sess = load_session()
    return cmd_stop({}) if running(sess) else cmd_start({})


USAGE = __doc__


def main(argv):
    if not argv:
        return cmd_toggle({})
    cmd, rest = argv[0], argv[1:]
    flags = {"_": [a for a in rest if not a.startswith("--")]}
    for a in rest:
        if a.startswith("--"):
            flags[a[2:]] = True
    table = {"start": cmd_start, "stop": cmd_stop, "status": cmd_status,
             "transcribe": cmd_transcribe, "devices": cmd_devices, "toggle": cmd_toggle}
    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if cmd not in table:
        sys.exit(USAGE)
    return table[cmd](flags)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
