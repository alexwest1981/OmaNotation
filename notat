def notat_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def utesluten(node, desc, mönster):
    text = f"{node} {desc}".lower()
    return any(m.lower() in text for m in mönster)


def pactl_json(kind):
    r = sh("pactl", "-f", "json", "list", kind)
    try:
        return json.loads(r.stdout or "[]")
    except ValueError:
        return []


def clean_desc(desc):
    d = (desc or "").strip()
    return d[len("Monitor of "):].strip() if d.startswith("Monitor of ") else d


def enheter_alla():
    """Alla enheter som går att välja, med vald-flagga (uteslutna listas också)."""
    mönster = notat_config().get("uteslut") or []
    ut = []
    for s in pactl_json("sinks"):
        name = (s.get("name") or "").strip()
        if not name or any(h in name.lower() for h in SKIP_HINTS):
            continue
        desc = clean_desc(s.get("description")) or name
        ut.append({"typ": "ut", "nod": name + ".monitor", "talare": "Mötet",
                   "beskrivning": desc, "vald": not utesluten(name, desc, mönster)})
    for s in pactl_json("sources"):
        name = (s.get("name") or "").strip()
        if not name or ".monitor" in name or any(h in name.lower() for h in SKIP_HINTS):
            continue
        desc = clean_desc(s.get("description")) or name
        ut.append({"typ": "in", "nod": name, "talare": "Du",
                   "beskrivning": desc, "vald": not utesluten(name, desc, mönster)})
    return ut


def device_list():
    """Varje ljudutgång och varje ljudingång — inte bara standardenheterna.

    'Allt ljud' betyder: spelar Zoom ut i hörlurarna medan videon går i högtalarna,
    eller byter du mic mitt i, fångas båda. En enhet per ffmpeg, så en död enhet
    (urkopplad USB, upptagen HDMI) fäller inte resten.
    """
    sink_env, source_env = os.environ.get("NOTAT_SINK"), os.environ.get("NOTAT_SOURCE")
    if sink_env or source_env:      # låst/testat läge: exakt två enheter
        sink = sink_env or sh("pactl", "get-default-sink").stdout.strip()
        source = source_env or sh("pactl", "get-default-source").stdout.strip()
        if not sink or not source:
            sys.exit("notat: pactl svarar inte (PipeWire igång?)")
        remote = sink if sink.endswith(".monitor") else sink + ".monitor"
        return [("ut", remote, "Mötet", "vald utgång"), ("in", source, "Du", "vald ingång")]
    UTESLUTNA.clear()
    tracks = []
    for d in enheter_alla():
        if d["vald"]:
            tracks.append((d["typ"], d["nod"], d["talare"], d["beskrivning"]))
        else:
            typ = "utgång" if d["typ"] == "ut" else "ingång"
            UTESLUTNA.append(f"{d['beskrivning']} ({typ})")
    if not tracks:
        sys.exit("notat: hittar inga ljudenheter (pactl -f json list sinks/sources)")
    return tracks


def cmd_valj(args):
    """Slår av/på en enhet i config, eller allt på: notat valj <nod> | notat valj alla"""
    mål = args["_"][0] if args["_"] else "alla"
    cfg = notat_config()
    mönster = list(cfg.get("uteslut") or [])
    if mål == "alla":
        cfg["uteslut"] = []
    else:
        träff = next((d for d in enheter_alla() if d["nod"] == mål), None)
        if träff is None:
            print(json.dumps({"ok": False, "error": f"okänd enhet: {mål}"}, ensure_ascii=False))
            return 1
        nyckel = mål[:-len(".monitor")] if mål.endswith(".monitor") else mål
        text = f"{nyckel} {träff['beskrivning']}".lower()
        kvar = [m for m in mönster if m.lower() not in text]     # matchande mönster bort
        # vald = påslagen nu: klicket ska slå AV den
        cfg["uteslut"] = kvar + [nyckel] if träff["vald"] else kvar
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except OSError as e:
        print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False))
        return 1
    log(f"valj {mål} -> uteslut={cfg['uteslut']}")
    print(json.dumps({"ok": True, "uteslut": cfg["uteslut"], "enheter": enheter_alla()},
                     ensure_ascii=False))
    return 0


def vault_root():
    """Var dokumenten hamnar: 'valv' i config först, sedan OmaScribes valv, annars egen mapp."""
    från_env = os.environ.get("NOTAT_VAULT")
    if från_env:
        return os.path.expanduser(från_env)
    egen = notat_config().get("valv")
    if egen:
        return os.path.expanduser(egen)
    try:
        with open(OMASCRIBE_CFG, encoding="utf-8") as f:
            root = json.load(f).get("vault_root")
        if root:
            return root
    except Exception:
        pass
    return VAULT_FALLBACK if os.path.isdir(VAULT_FALLBACK) else os.path.join(HOME, "Documents/Anteckningar")


def load_session():
    try:
        with open(SESSION, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def alive(pid):
    """Lever processen, och är det fortfarande vår ffmpeg? (pid återanvänds annars)"""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return b"ffmpeg" in f.read()
    except OSError:
        return False


def session_pids(sess):
    if not sess:
        return []
    pids = [t.get("pid") for t in sess.get("tracks") or []]
    if sess.get("pid"):
        pids.append(sess["pid"])          # äldre sessioner
    return [p for p in pids if p]


def running(sess):
    """True så länge minst en av inspelningarna lever."""
    return any(alive(p) for p in session_pids(sess))


def log(msg):
    """Liten händelselogg: vem (förälder) gjorde vad - annars går det inte att utreda."""
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        ppid = os.getppid()
        try:
            with open(f"/proc/{ppid}/cmdline", "rb") as f:
                parent = f.read().replace(b"\0", b" ").decode(errors="replace").strip()[:120]
        except OSError:
            parent = "?"
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat(timespec='seconds')} {msg} (förälder {ppid}: {parent})\n")
    except OSError:
        pass


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "notat", title, body])


# ------------------------------------------------------------------ start/stopp

def cmd_start(_args):
    sess = load_session()
    if running(sess):
        print(json.dumps({"ok": False, "error": "spelar redan in", "since": sess["started"]}))
        return 0
    tracks = device_list()
    stamp = datetime.now().strftime("%Y-%m-%d %H-%M")
    outdir = os.path.join(RAW_ROOT, stamp)
    n = 2
    while os.path.exists(os.path.join(outdir, "session.json")):
        outdir = os.path.join(RAW_ROOT, f"{stamp}-{n}")   # två inspelningar samma minut
        n += 1
    os.makedirs(outdir, exist_ok=True)
    started = []
    for i, (kind, node, label, desc) in enumerate(tracks, 1):
        name = f"{kind}{i}"
        fflog = open(os.path.join(outdir, name + ".log"), "w")
        proc = subprocess.Popen([
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "warning",
            "-f", "pulse", "-i", node,
            "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", os.path.join(outdir, name + ".wav"),
        ], stdout=fflog, stderr=fflog, stdin=subprocess.DEVNULL, start_new_session=True)
        started.append({"file": name + ".wav", "node": node, "label": label,
                        "desc": desc, "pid": proc.pid})
    time.sleep(1.0)
    live = [t for t in started if alive(t["pid"])]
    if not live:
        why = []
        for t in started:
            try:
                with open(os.path.join(outdir, t["file"].replace(".wav", ".log")),
                          encoding="utf-8", errors="replace") as f:
                    tail = f.read()[-200:].strip()
            except OSError:
                tail = "?"
            why.append(f"{t['desc']}: {tail}")
        # ponytail: en död enhet får inte tysta de andra - bara noll levande är fel
        print(json.dumps({"ok": False, "error": "ingen enhet kunde spelas in: " + " | ".join(why)},
                         ensure_ascii=False))
        return 1
    info = {"started": time.time(), "dir": outdir, "tracks": live, "pid": live[0]["pid"]}
    os.makedirs(STATE, exist_ok=True)
    for path in (SESSION, os.path.join(outdir, "session.json")):
        with open(path, "w", encoding="utf-8") as f:
            json.dump(info, f)
    names = ", ".join(t["desc"] for t in live)
    notify("Spelar in", f"{len(live)} enheter: {names[:70]}")
    log(f"start {outdir} {len(live)}/{len(started)} enheter: {names}")
    print(json.dumps({"ok": True, "dir": outdir,
                      "tracks": [{"desc": t["desc"], "node": t["node"]} for t in live]},
                     ensure_ascii=False))
    return 0


def stop_ffmpeg(sess):
    pids = [p for p in session_pids(sess) if alive(p)]
    for pid in pids:
        os.kill(pid, signal.SIGINT)          # ffmpeg skriver klart wav-huvudet
    for _ in range(100):
        if not any(alive(p) for p in pids):
            return True
        time.sleep(0.1)
    for pid in pids:
        if alive(pid):
            os.kill(pid, signal.SIGTERM)
    return True


def cmd_stop(args):
    sess = load_session()
    if not sess:
        print(json.dumps({"ok": False, "error": "ingen inspelning"}))
        return 1
    was_live = running(sess)
    stop_ffmpeg(sess)
    seconds = int((sess.get("stopped") or time.time()) - sess["started"]) if not was_live else int(time.time() - sess["started"])
    try:
        os.unlink(SESSION)
    except OSError:
        pass
    if seconds < 3 and not args.get("force"):
        notify("Ingen inspelning", "Kortare än 3 sekunder - inget dokument skapades")
        log(f"stop avbruten: bara {seconds}s")
        print(json.dumps({"ok": False, "error": "för kort", "seconds": seconds}))
        return 1
    path = transcribe_dir(sess["dir"], seconds, sammanfatta=not args.get("no-summary"))
    log(f"stop efter {seconds}s -> {path}")
    print(json.dumps({"ok": bool(path), "note": path, "seconds": seconds}))
    return 0 if path else 1


