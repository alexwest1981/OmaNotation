             "sökväg": modell_sökväg(m["id"])} for m in MODELLER]


def find_model():
    """Vald modell ur config (barens meny), annars NOTAT_MODEL, annars standardordningen."""
    for nyckel, värde in (("config", notat_config().get("modell")),
                          ("NOTAT_MODEL", os.environ.get("NOTAT_MODEL"))):
        if not värde:
            continue
        if os.path.exists(värde):
            return värde
        p = modell_sökväg(värde)
        if p:
            return p
        sys.exit(f"notat: modellen '{värde}' ({nyckel}) finns inte nedladdad - "
                 f"öppna källmenyn i baren eller kör: notat hamta {värde}")
    for d in MODEL_DIRS:
        if not d:
            continue
        for name in FOLDERS:
            p = os.path.join(d, f"ggml-{name}.bin")
            if os.path.exists(p):
                return p
    sys.exit("notat: hittar ingen whisper-modell (sätt NOTAT_MODEL eller ladda ner en i baren)")


def ladda_ner(url, tmp, min_mb=1):
    """Strömmar en fil till tmp och skriver {"procent": N} per rad (barens mätare läser dem)."""
    req = urllib.request.Request(url, headers={"User-Agent": "notat/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r, open(tmp, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        klart, nästa = 0, 0
        while True:
            bit = r.read(1 << 20)
            if not bit:
                break
            f.write(bit)
            klart += len(bit)
            p = int(klart * 100 / total) if total else 0
            if p >= nästa:
                print(json.dumps({"procent": p, "mb": klart >> 20}), flush=True)
                nästa = p + 5
    if os.path.getsize(tmp) < min_mb * 1_000_000:
        raise ValueError("filen är för liten - nedladdningen gick fel")


